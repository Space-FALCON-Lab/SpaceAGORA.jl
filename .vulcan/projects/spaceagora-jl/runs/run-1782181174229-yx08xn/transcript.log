{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WLgkhyFUhNvfM5m1Mfv5X1","type":"tool_result","content":"1\t# Attitude Determination Subsystem -- Multiplicative Extended Kalman Filter\n2\t# DRM 1 | Requirements: ADS-FLT-001 through ADS-FLT-003\n3\t# State: [d_theta (3, attitude error), d_b (3, gyro bias error)] = 6 states\n4\t\n5\tusing LinearAlgebra\n6\t\n7\tmutable struct ADSMEKFState\n8\t    q_est::Vector{Float64}\n9\t    gyro_bias::Vector{Float64}\n10\t    P::Matrix{Float64}\n11\tend\n12\t\n13\tfunction ads_mekf_init(;\n14\t    q0::AbstractVector = [1.0,0.0,0.0,0.0],\n15\t    bias0::AbstractVector = zeros(3),\n16\t    P0::AbstractMatrix = 1e-4*Matrix{Float64}(I,6,6))\n17\t    ADSMEKFState(normalize(q0), collect(Float64,bias0), collect(Float64,P0))\n18\tend\n19\t\n20\tfunction ads_mekf_predict!(state::ADSMEKFState, omega_meas::AbstractVector, dt::Float64, Q::AbstractMatrix)\n21\t    omega = omega_meas .- state.gyro_bias\n22\t    theta = norm(omega)*dt\n23\t    if theta > 1e-12\n24\t        axis = omega./norm(omega)\n25\t        dq = [cos(theta/2); axis.*sin(theta/2)]\n26\t        state.q_est = normalize(quat_multiply(state.q_est, dq))\n27\t    end\n28\t    Om = skew(omega)\n29\t    F = [Matrix{Float64}(I,3,3)-Om*dt  -dt*Matrix{Float64}(I,3,3);\n30\t         zeros(3,3)                     Matrix{Float64}(I,3,3)]\n31\t    state.P = F*state.P*F' + Q\n32\tend\n33\t\n34\tfunction ads_mekf_update_star_tracker!(state::ADSMEKFState, q_meas::AbstractVector, R_st::AbstractMatrix)\n35\t    q_inv = [state.q_est[1]; -state.q_est[2:4]]\n36\t    dq = quat_multiply(q_inv, q_meas)\n37\t    sign_w = dq[1] >= 0 ? 1.0 : -1.0\n38\t    z = 2.0*sign_w*dq[2:4]\n39\t    H = [Matrix{Float64}(I,3,3)  zeros(3,3)]\n40\t    _kf_update!(state, z, H, R_st)\n41\tend\n42\t\n43\tfunction ads_mekf_update_vector!(state::ADSMEKFState, b_meas::AbstractVector, b_ref_I::AbstractVector, R_vec::AbstractMatrix)\n44\t    b_pred = quat_rotate(state.q_est, normalize(b_ref_I))\n45\t    z = b_meas .- b_pred\n46\t    H = [-skew(b_pred)  zeros(3,3)]\n47\t    _kf_update!(state, z, H, R_vec)\n48\tend\n49\t\n50\tfunction _kf_update!(state::ADSMEKFState, z::AbstractVector, H::AbstractMatrix, R::AbstractMatrix)\n51\t    S = H*state.P*H' + R\n52\t    K = state.P*H'*(S\\Matrix{Float64}(I,size(S)...))\n53\t    dx = K*z\n54\t    dphi = dx[1:3]\n55\t    angle = norm(dphi)\n56\t    if angle > 1e-12\n57\t        dq = quat_from_axis_angle(dphi./angle, angle)\n58\t        state.q_est = normalize(quat_multiply(state.q_est, dq))\n59\t    end\n60\t    state.gyro_bias .+= dx[4:6]\n61\t    I6 = Matrix{Float64}(I,6,6)\n62\t    IKH = I6 - K*H\n63\t    state.P = IKH*state.P*IKH' + K*R*K'\n64\tend\n65\t\n66\tfunction compute_nees(state::ADSMEKFState, q_true::AbstractVector)\n67\t    q_inv = [state.q_est[1]; -state.q_est[2:4]]\n68\t    dq = quat_multiply(q_inv, q_true)\n69\t    sign_w = dq[1] >= 0 ? 1.0 : -1.0\n70\t    err = 2.0*sign_w*dq[2:4]\n71\t    P_att = state.P[1:3,1:3]\n72\t    err'*(P_att\\err)\n73\tend\n74\t\n75\tattitude_error_deg(s::ADSMEKFState, q_true::AbstractVector) = quat_angle_deg(s.q_est, q_true)\n76\t\n77\tfunction skew(v::AbstractVector)\n78\t    [0.0 -v[3] v[2]; v[3] 0.0 -v[1]; -v[2] v[1] 0.0]\n79\tend\n80\t"}]},"parent_tool_use_id":null,"session_id":"246a8ecb-0681-4d99-8a91-630970bd5e2f","uuid":"c4ad5a08-2d09-418b-bdda-471559e81481","timestamp":"2026-06-23T02:20:20.878Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Robbie/falcon/SpaceAGORA.jl/src/gnc/navigation/ads_mekf.jl","content":"# Attitude Determination Subsystem -- Multiplicative Extended Kalman Filter\n# DRM 1 | Requirements: ADS-FLT-001 through ADS-FLT-003\n# State: [d_theta (3, attitude error), d_b (3, gyro bias error)] = 6 states\n\nusing LinearAlgebra\n\nmutable struct ADSMEKFState\n    q_est::Vector{Float64}\n    gyro_bias::Vector{Float64}\n    P::Matrix{Float64}\nend\n\nfunction ads_mekf_init(;\n    q0::AbstractVector = [1.0,0.0,0.0,0.0],\n    bias0::AbstractVector = zeros(3),\n    P0::AbstractMatrix = 1e-4*Matrix{Float64}(I,6,6))\n    ADSMEKFState(normalize(q0), collect(Float64,bias0), collect(Float64,P0))\nend\n\nfunction ads_mekf_predict!(state::ADSMEKFState, omega_meas::AbstractVector, dt::Float64, Q::AbstractMatrix)\n    omega = omega_meas .- state.gyro_bias\n    theta = norm(omega)*dt\n    if theta > 1e-12\n        axis = omega./norm(omega)\n        dq = [cos(theta/2); axis.*sin(theta/2)]\n        state.q_est = normalize(quat_multiply(state.q_est, dq))\n    end\n    Om = skew(omega)\n    F = [Matrix{Float64}(I,3,3)-Om*dt  -dt*Matrix{Float64}(I,3,3);\n         zeros(3,3)                     Matrix{Float64}(I,3,3)]\n    state.P = F*state.P*F' + Q\nend\n\nfunction ads_mekf_update_star_tracker!(state::ADSMEKFState, q_meas::AbstractVector, R_st::AbstractMatrix)\n    q_inv = [state.q_est[1]; -state.q_est[2:4]]\n    dq = quat_multiply(q_inv, q_meas)\n    sign_w = dq[1] >= 0 ? 1.0 : -1.0\n    z = 2.0*sign_w*dq[2:4]\n    H = [Matrix{Float64}(I,3,3)  zeros(3,3)]\n    _kf_update!(state, z, H, R_st)\nend\n\nfunction ads_mekf_update_vector!(state::ADSMEKFState, b_meas::AbstractVector, b_ref_I::AbstractVector, R_vec::AbstractMatrix)\n    b_pred = quat_rotate(state.q_est, normalize(b_ref_I))\n    z = b_meas .- b_pred\n    H = [-skew(b_pred)  zeros(3,3)]\n    _kf_update!(state, z, H, R_vec)\nend\n\nfunction _kf_update!(state::ADSMEKFState, z::AbstractVector, H::AbstractMatrix, R::AbstractMatrix)\n    S = H*state.P*H' + R\n    K = state.P*H'*(S\\Matrix{Float64}(I,size(S)...))\n    dx = K*z\n    dphi = dx[1:3]\n    angle = norm(dphi)\n    if angle > 1e-12\n        dq = quat_from_axis_angle(dphi./angle, angle)\n        state.q_est = normalize(quat_multiply(state.q_est, dq))\n    end\n    state.gyro_bias .+= dx[4:6]\n    I6 = Matrix{Float64}(I,6,6)\n    IKH = I6 - K*H\n    state.P = IKH*state.P*IKH' + K*R*K'\nend\n\nfunction compute_nees(state::ADSMEKFState, q_true::AbstractVector)\n    q_inv = [state.q_est[1]; -state.q_est[2:4]]\n    dq = quat_multiply(q_inv, q_true)\n    sign_w = dq[1] >= 0 ? 1.0 : -1.0\n    err = 2.0*sign_w*dq[2:4]\n    P_att = state.P[1:3,1:3]\n    err'*(P_att\\err)\nend\n\nattitude_error_deg(s::ADSMEKFState, q_true::AbstractVector) = quat_angle_deg(s.q_est, q_true)\n\nfunction skew(v::AbstractVector)\n    [0.0 -v[3] v[2]; v[3] 0.0 -v[1]; -v[2] v[1] 0.0]\nend\n","numLines":80,"startLine":1,"totalLines":80}}}
