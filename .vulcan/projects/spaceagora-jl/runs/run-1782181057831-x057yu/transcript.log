{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011e13Q3oRFFFmoSE4Y6W8XH","type":"tool_result","content":"1\t# ADS Test Suite -- DRM 1 Verification\n2\t# Requirements: ADS-VNV-001 (sensor statistics), ADS-VNV-002 (MEKF convergence),\n3\t#               ADS-VNV-003 (filter consistency NEES)\n4\t# Run: julia --startup-file=no test/gnc/ads_tests.jl\n5\t#\n6\t# Structured output: emits #VULCAN_VNV: <json> markers for Vulcan to parse.\n7\t# Raw data: writes CSV files to $VULCAN_RUN_DIR/vnv-artifacts/ if set.\n8\t\n9\tusing Test, LinearAlgebra, Statistics, Random\n10\t\n11\tconst GNC_NAV = joinpath(@__DIR__, \"../../src/gnc/navigation\")\n12\tinclude(joinpath(GNC_NAV, \"ads_sensor_models.jl\"))\n13\tinclude(joinpath(GNC_NAV, \"ads_mekf.jl\"))\n14\tinclude(joinpath(GNC_NAV, \"ads_mode_manager.jl\"))\n15\t\n16\t# -- Artifact output -----------------------------------------------------------\n17\t\n18\tconst ARTIFACTS_DIR = let\n19\t    d = get(ENV, \"VULCAN_RUN_DIR\", \"\")\n20\t    isempty(d) ? nothing : begin\n21\t        adir = joinpath(d, \"vnv-artifacts\")\n22\t        mkpath(adir)\n23\t        adir\n24\t    end\n25\tend\n26\t\n27\tfunction write_artifact(filename::String, content::String)\n28\t    ARTIFACTS_DIR === nothing && return filename\n29\t    p = joinpath(ARTIFACTS_DIR, filename)\n30\t    write(p, content)\n31\t    return p\n32\tend\n33\t\n34\t# Minimal JSON serializer (no external deps)\n35\tfunction to_json(x)\n36\t    if x isa AbstractDict\n37\t        pairs_str = join([\"$(to_json(string(k))):$(to_json(v))\" for (k,v) in x], \",\")\n38\t        return \"{$(pairs_str)}\"\n39\t    elseif x isa AbstractVector\n40\t        return \"[\" * join(map(to_json, x), \",\") * \"]\"\n41\t    elseif x isa AbstractString\n42\t        esc = replace(string(x), \"\\\\\" => \"\\\\\\\\\", \"\\\"\" => \"\\\\\\\"\", \"\\n\" => \"\\\\n\")\n43\t        return \"\\\"$(esc)\\\"\"\n44\t    elseif x === nothing || x === missing\n45\t        return \"null\"\n46\t    elseif x isa Bool\n47\t        return x ? \"true\" : \"false\"\n48\t    elseif x isa Number\n49\t        return (isnan(x) || isinf(x)) ? \"null\" : string(x)\n50\t    else\n51\t        return \"\\\"$(string(x))\\\"\"\n52\t    end\n53\tend\n54\t\n55\tfunction emit_vnv(; requirement_ids, metrics, artifacts=[], summary, passed)\n56\t    d = Dict(\n57\t        \"requirement_ids\" => requirement_ids,\n58\t        \"metrics\" => metrics,\n59\t        \"artifacts\" => artifacts,\n60\t        \"summary\" => summary,\n61\t        \"passed\" => passed\n62\t    )\n63\t    println(\"#VULCAN_VNV: \" * to_json(d))\n64\tend\n65\t\n66\t# -- Helpers -------------------------------------------------------------------\n67\t\n68\trand_quat(rng=Random.GLOBAL_RNG) = normalize(randn(rng, 4))\n69\t\n70\tperturb_quat(q, deg, rng=Random.GLOBAL_RNG) =\n71\t    normalize(quat_multiply(q, quat_from_axis_angle(normalize(randn(rng, 3)), deg*pi/180)))\n72\t\n73\tfunction run_mekf_sim(q_true_init, q_init, omega_true;\n74\t                      dt=1.0, N=60, P0_scale=1e-2, rng=Random.GLOBAL_RNG,\n75\t                      B_I=[15000.0,0.0,35000.0], sun_body=[1.0,0.0,0.0])\n76\t    q_true = copy(q_true_init)\n77\t    P0 = P0_scale * Matrix{Float64}(I, 6, 6)\n78\t    state = ads_mekf_init(q0=q_init, P0=P0)\n79\t    st = StarTrackerModel(); gyr = GyroModel(); mag = MagnetometerModel()\n80\t    R_st = (5.0*pi/180/3600)^2 * Matrix{Float64}(I, 3, 3)\n81\t    Q = 1e-6 * Matrix{Float64}(I, 6, 6)\n82\t    errors = Float64[]; nees_vals = Float64[]\n83\t    for _ in 1:N\n84\t        th = norm(omega_true)*dt\n85\t        dq = quat_from_axis_angle(normalize(omega_true), th)\n86\t        q_true = normalize(quat_multiply(q_true, dq))\n87\t        (om, _) = measure_gyro!(gyr, omega_true, dt)\n88\t        (q_st, st_ok) = measure_star_tracker(st, q_true, sun_body, false)\n89\t        ads_mekf_predict!(state, om, dt, Q)\n90\t        st_ok && ads_mekf_update_star_tracker!(state, q_st, R_st)\n91\t        push!(errors, attitude_error_deg(state, q_true))\n92\t        push!(nees_vals, compute_nees(state, q_true))\n93\t    end\n94\t    (state, errors, nees_vals, q_true)\n95\tend\n96\t\n97\t# -- Tests ---------------------------------------------------------------------\n98\t\n99\t@testset \"ADS DRM 1 -- Full Verification\" begin\n100\t\n101\t  @testset \"ADS-VNV-001 Sensor Noise Statistics\" begin\n102\t    rng = MersenneTwister(42); N = 2000\n103\t    q_id = [1.0,0.0,0.0,0.0]; B_I = [15000.0,0.0,35000.0]\n104\t\n105\t    st = StarTrackerModel(noise_arcsec=5.0)\n106\t    st_errors = [begin\n107\t        (q_m,ok) = measure_star_tracker(st, q_id, [1.0,0.0,0.0], false)\n108\t        ok ? quat_angle_deg(q_id, q_m)*pi/180 : NaN\n109\t    end for _ in 1:N]\n110\t    st_errors = filter(!isnan, st_errors)\n111\t    st_sigma_arcsec = std(st_errors)*180/pi*3600\n112\t    st_pass = length(st_errors) > 0.9N && std(st_errors) < st.noise_sigma_rad*10\n113\t    @test st_pass\n114\t\n115\t    mag = MagnetometerModel(noise_nT=50.0)\n116\t    b_true = normalize(quat_rotate(q_id, B_I))\n117\t    mag_angles = [begin\n118\t        (b,ok) = measure_magnetometer(mag, q_id, B_I)\n119\t        ok ? acos(clamp(dot(b,b_true),-1.0,1.0))*180/pi : NaN\n120\t    end for _ in 1:N]\n121\t    mag_angles = filter(!isnan, mag_angles)\n122\t    mag_sigma_deg = std(mag_angles)\n123\t    mag_pass = mag_sigma_deg < 2.0\n124\t    @test mag_pass\n125\t\n126\t    sun = SunSensorModel(noise_deg=1.0, fov_deg=70.0)\n127\t    sun_body_ref = quat_rotate(q_id, [0.0,0.0,1.0])\n128\t    sun_angles = [begin\n129\t        (s,ok) = measure_sun_sensor(sun, q_id, [0.0,0.0,1.0], false)\n130\t        ok ? acos(clamp(dot(s,sun_body_ref),-1.0,1.0))*180/pi : NaN\n131\t    end for _ in 1:N]\n132\t    sun_angles = filter(!isnan, sun_angles)\n133\t    sun_sigma_deg = std(sun_angles)\n134\t    sun_pass = sun_sigma_deg < 5.0\n135\t    @test sun_pass\n136\t\n137\t    println(\"  Star tracker noise sigma = $(round(st_sigma_arcsec,digits=2)) arcsec (spec 5)\")\n138\t    println(\"  Magnetometer angular noise sigma = $(round(mag_sigma_deg,digits=3)) deg\")\n139\t    println(\"  Sun sensor noise sigma = $(round(sun_sigma_deg,digits=3)) deg (spec 1)\")\n140\t    println(\"  ADS-VNV-001 PASS\")\n141\t\n142\t    write_artifact(\"sensor_noise_stats.csv\",\n143\t        \"sensor,measured_sigma,spec_sigma,unit,passed\\n\" *\n144\t        \"star_tracker,$(round(st_sigma_arcsec,digits=3)),5.0,arcsec,$(st_pass)\\n\" *\n145\t        \"magnetometer,$(round(mag_sigma_deg,digits=4)),2.0,deg,$(mag_pass)\\n\" *\n146\t        \"sun_sensor,$(round(sun_sigma_deg,digits=4)),5.0,deg,$(sun_pass)\\n\")\n147\t\n148\t    emit_vnv(\n149\t        requirement_ids=[\"ADS-VNV-001\",\"ADS-SNS-001\",\"ADS-SNS-002\",\"ADS-SNS-003\",\"ADS-SNS-004\"],\n150\t        metrics=[\n151\t            Dict(\"name\"=>\"star_tracker_noise_arcsec\",\"label\"=>\"Star Tracker Noise\",\"value\"=>round(st_sigma_arcsec,digits=3),\"unit\"=>\"arcsec\",\"spec\"=>5.0,\"spec_operator\"=>\"<=\",\"passed\"=>st_pass),\n152\t            Dict(\"name\"=>\"magnetometer_noise_deg\",\"label\"=>\"Magnetometer Angular Noise\",\"value\"=>round(mag_sigma_deg,digits=4),\"unit\"=>\"deg\",\"spec\"=>2.0,\"spec_operator\"=>\"<=\",\"passed\"=>mag_pass),\n153\t            Dict(\"name\"=>\"sun_sensor_noise_deg\",\"label\"=>\"Sun Sensor Angular Noise\",\"value\"=>round(sun_sigma_deg,digits=4),\"unit\"=>\"deg\",\"spec\"=>5.0,\"spec_operator\"=>\"<=\",\"passed\"=>sun_pass),\n154\t        ],\n155\t        artifacts=[Dict(\n156\t            \"kind\"=>\"table\",\"title\"=>\"Sensor Noise Statistics\",\n157\t            \"description\"=>\"Measured 1-sigma noise vs spec for each sensor model (N=$(N) trials each)\",\n158\t            \"data_file_name\"=>\"sensor_noise_stats.csv\",\n159\t            \"table_columns\"=>[\n160\t                Dict(\"field\"=>\"sensor\",\"label\"=>\"Sensor\"),\n161\t                Dict(\"field\"=>\"measured_sigma\",\"label\"=>\"Measured 1-sigma\"),\n162\t                Dict(\"field\"=>\"spec_sigma\",\"label\"=>\"Spec\"),\n163\t                Dict(\"field\"=>\"unit\",\"label\"=>\"Unit\"),\n164\t                Dict(\"field\"=>\"passed\",\"label\"=>\"Pass\",\"is_pass_fail\"=>true),\n165\t            ],\n166\t            \"inline_data\"=>[\n167\t                Dict(\"sensor\"=>\"Star Tracker\",\"measured_sigma\"=>round(st_sigma_arcsec,digits=3),\"spec_sigma\"=>5.0,\"unit\"=>\"arcsec\",\"passed\"=>st_pass),\n168\t                Dict(\"sensor\"=>\"Magnetometer\",\"measured_sigma\"=>round(mag_sigma_deg,digits=4),\"spec_sigma\"=>2.0,\"unit\"=>\"deg\",\"passed\"=>mag_pass),\n169\t                Dict(\"sensor\"=>\"Sun Sensor\",\"measured_sigma\"=>round(sun_sigma_deg,digits=4),\"spec_sigma\"=>5.0,\"unit\"=>\"deg\",\"passed\"=>sun_pass),\n170\t            ],\n171\t        )],\n172\t        summary=\"Sensor noise: ST=$(round(st_sigma_arcsec,digits=2)) arcsec, Mag=$(round(mag_sigma_deg,digits=3)) deg, Sun=$(round(sun_sigma_deg,digits=3)) deg.\",\n173\t        passed=st_pass && mag_pass && sun_pass\n174\t    )\n175\t  end\n176\t\n177\t  @testset \"ADS-VNV-002 MEKF Convergence from 5 deg\" begin\n178\t    rng = MersenneTwister(123)\n179\t    q_truth = [1.0,0.0,0.0,0.0]\n180\t    q_init = perturb_quat(q_truth, 5.0, rng)\n181\t    (_, errors, _, _) = run_mekf_sim(q_truth, q_init, [0.001,-0.0005,0.002]; N=60, rng=rng)\n182\t    final_err = errors[end]\n183\t    conv_pass = final_err < 0.1\n184\t    println(\"  Attitude error after 60 s: $(round(final_err,digits=5)) deg (spec <=0.1)\")\n185\t    @test conv_pass\n186\t    println(\"  ADS-VNV-002 PASS\")\n187\t\n188\t    write_artifact(\"mekf_convergence.csv\",\n189\t        \"step_s,error_deg\\n\" * join([\"$(i),$(round(errors[i],digits=6))\" for i in eachindex(errors)], \"\\n\") * \"\\n\")\n190\t\n191\t    emit_vnv(\n192\t        requirement_ids=[\"ADS-VNV-002\",\"ADS-SYS-005\",\"ADS-FLT-001\"],\n193\t        metrics=[Dict(\"name\"=>\"final_attitude_error_deg\",\"label\"=>\"Final Attitude Error\",\"value\"=>round(final_err,digits=6),\"unit\"=>\"deg\",\"spec\"=>0.1,\"spec_operator\"=>\"<=\",\"passed\"=>conv_pass)],\n194\t        artifacts=[Dict(\n195\t            \"kind\"=>\"plot\",\"title\"=>\"MEKF Convergence\",\n196\t            \"description\"=>\"Attitude error vs time from 5 deg initial error. ST + gyro at 1 Hz.\",\n197\t            \"data_file_name\"=>\"mekf_convergence.csv\",\n198\t            \"plot_spec\"=>Dict(\n199\t                \"type\"=>\"time-series\",\"title\"=>\"MEKF Convergence from 5 deg Initial Error\",\n200\t                \"xAxis\"=>Dict(\"field\"=>\"step_s\",\"label\"=>\"Time\",\"unit\"=>\"s\"),\n201\t                \"yAxis\"=>Dict(\"field\"=>\"error_deg\",\"label\"=>\"Attitude Error\",\"unit\"=>\"deg\"),\n202\t                \"referenceLines\"=>[Dict(\"value\"=>0.1,\"label\"=>\"ADS-SYS-005 spec (0.1 deg)\",\"color\"=>\"#e74c3c\")],\n203\t            ),\n204\t        )],\n205\t        summary=\"MEKF converges from 5 deg to $(round(final_err,digits=5)) deg in 60 s.\",\n206\t        passed=conv_pass\n207\t    )\n208\t  end\n209\t\n210\t  @testset \"ADS-VNV-003 Filter Consistency NEES\" begin\n211\t    N_trials = 100; all_nees = Float64[]\n212\t    nees_rows = Tuple{Int,Int,Float64}[]\n213\t    for trial in 1:N_trials\n214\t        rng_t = MersenneTwister(trial+1000)\n215\t        q_truth = rand_quat(rng_t)\n216\t        q_init = perturb_quat(q_truth, 5.0*abs(randn(rng_t)), rng_t)\n217\t        omega_t = 0.001 .* randn(rng_t, 3)\n218\t        (_, _, nees_vals, _) = run_mekf_sim(q_truth, q_init, omega_t; N=40, P0_scale=1e-2, rng=rng_t)\n219\t        for (s,n) in enumerate(nees_vals[11:end])\n220\t            isfinite(n) || continue\n221\t            push!(all_nees, n); push!(nees_rows, (trial, s+10, n))\n222\t        end\n223\t    end\n224\t    frac = count(n->0.352<=n<=7.815, all_nees)/length(all_nees)\n225\t    mu_nees = mean(all_nees)\n226\t    cons_pass = frac>=0.50 && mu_nees<15.0\n227\t    println(\"  NEES mean = $(round(mu_nees,digits=3)) (expected ~3.0 for chi2(3))\")\n228\t    println(\"  Fraction in 95% CI: $(round(frac*100,digits=1))% (N=$(length(all_nees)))\")\n229\t    @test cons_pass\n230\t    println(\"  ADS-VNV-003 PASS\")\n231\t\n232\t    write_artifact(\"nees_distribution.csv\",\n233\t        \"trial,step,nees\\n\" * join([\"$(t),$(s),$(round(n,digits=4))\" for (t,s,n) in nees_rows[1:min(end,2000)]], \"\\n\") * \"\\n\")\n234\t    write_artifact(\"nees_summary.csv\",\n235\t        \"metric,value\\nmean_nees,$(round(mu_nees,digits=4))\\nfrac_in_ci,$(round(frac,digits=4))\\nn_total,$(length(all_nees))\\n\")\n236\t\n237\t    emit_vnv(\n238\t        requirement_ids=[\"ADS-VNV-003\",\"ADS-SYS-006\",\"ADS-FLT-003\"],\n239\t        metrics=[\n240\t            Dict(\"name\"=>\"nees_mean\",\"label\"=>\"NEES Mean\",\"value\"=>round(mu_nees,digits=4),\"unit\"=>\"\",\"spec\"=>nothing,\"spec_operator\"=>\"<=\",\"passed\"=>mu_nees<15.0),\n241\t            Dict(\"name\"=>\"nees_ci_fraction\",\"label\"=>\"Fraction in 95% CI\",\"value\"=>round(frac,digits=4),\"unit\"=>\"\",\"spec\"=>0.50,\"spec_operator\"=>\">=\",\"passed\"=>frac>=0.50),\n242\t        ],\n243\t        artifacts=[\n244\t            Dict(\"kind\"=>\"plot\",\"title\"=>\"NEES Distribution ($(N_trials) MC Trials)\",\"description\"=>\"chi^2(3) 95% CI: [0.352, 7.815]. Conservative filter: most samples near 0.\",\"data_file_name\"=>\"nees_distribution.csv\",\"plot_spec\"=>Dict(\"type\"=>\"histogram\",\"title\"=>\"NEES Distribution\",\"xAxis\"=>Dict(\"field\"=>\"nees\",\"label\"=>\"NEES\",\"unit\"=>\"\"),\"yAxis\"=>Dict(\"field\"=>\"count\",\"label\"=>\"Count\",\"unit\"=>\"\"),\"referenceLines\"=>[Dict(\"value\"=>0.352,\"label\"=>\"CI lower\",\"color\"=>\"#2196f3\"),Dict(\"value\"=>7.815,\"label\"=>\"CI upper\",\"color\"=>\"#2196f3\"),Dict(\"value\"=>3.0,\"label\"=>\"expected mean\",\"color\"=>\"#4caf50\")])),\n245\t            Dict(\"kind\"=>\"table\",\"title\"=>\"NEES Consistency Summary\",\"description\"=>\"Filter consistency statistics from Monte Carlo\",\"data_file_name\"=>\"nees_summary.csv\",\"table_columns\"=>[Dict(\"field\"=>\"metric\",\"label\"=>\"Metric\"),Dict(\"field\"=>\"value\",\"label\"=>\"Value\")],\"inline_data\"=>[Dict(\"metric\"=>\"Mean NEES\",\"value\"=>round(mu_nees,digits=3)),Dict(\"metric\"=>\"Fraction in 95% CI\",\"value\"=>string(round(frac*100,digits=1))*\"%\"),Dict(\"metric\"=>\"N samples\",\"value\"=>length(all_nees))]),\n246\t        ],\n247\t        summary=\"NEES ($(N_trials) MC trials): mean=$(round(mu_nees,digits=3)), $(round(frac*100,digits=1))% in 95% CI.\",\n248\t        passed=cons_pass\n249\t    )\n250\t  end\n251\t\n252\t  @testset \"Mode State Machine Transitions\" begin\n253\t    all_ok = Dict(:star_tracker=>true,:gyro=>true,:magnetometer=>true,:sun_sensor=>true)\n254\t    no_gyro = Dict(:star_tracker=>true,:gyro=>false,:magnetometer=>true,:sun_sensor=>true)\n255\t    mgr = ads_mode_init()\n256\t    @test mgr.current_mode == INIT\n257\t    ads_mode_update!(mgr, all_ok, false, 0.0, 10.0); @test mgr.current_mode == COARSE_ACQ\n258\t    ads_mode_update!(mgr, all_ok, false, 0.0, 1.0);  @test mgr.current_mode == FINE_TRACK\n259\t    ads_mode_update!(mgr, all_ok, true,  0.0, 0.05); @test mgr.current_mode == ECLIPSE\n260\t    ads_mode_update!(mgr, all_ok, false, 0.0, 0.05); @test mgr.current_mode == FINE_TRACK\n261\t    ads_mode_update!(mgr, no_gyro, false, 0.0, 0.05); @test mgr.current_mode == SAFE\n262\t    ads_mode_update!(mgr, all_ok, false, 0.0, 0.0, true); @test mgr.current_mode == INIT\n263\t    mgr2 = ads_mode_init(); mgr2.current_mode = FINE_TRACK\n264\t    @test :star_tracker in ads_mode_get_active_sensors(mgr2)\n265\t    mgr3 = ads_mode_init(); mgr3.current_mode = ECLIPSE\n266\t    @test :magnetometer in ads_mode_get_active_sensors(mgr3)\n267\t    @test !(:star_tracker in ads_mode_get_active_sensors(mgr3))\n268\t    println(\"  Mode state machine: all 6 transitions PASS\")\n269\t\n270\t    write_artifact(\"mode_transitions.csv\",\n271\t        \"from_mode,to_mode,trigger,passed\\n\" *\n272\t        \"INIT,COARSE_ACQ,sensors_healthy,true\\n\" *\n273\t        \"COARSE_ACQ,FINE_TRACK,ST_locked_and_error_lt_2deg,true\\n\" *\n274\t        \"FINE_TRACK,ECLIPSE,eclipse_entered,true\\n\" *\n275\t        \"ECLIPSE,FINE_TRACK,eclipse_exited_and_ST_healthy,true\\n\" *\n276\t        \"FINE_TRACK,SAFE,gyro_failure,true\\n\" *\n277\t        \"SAFE,INIT,reset_command,true\\n\")\n278\t\n279\t    emit_vnv(\n280\t        requirement_ids=[\"ADS-SYS-004\"],\n281\t        metrics=[Dict(\"name\"=>\"mode_transitions_passed\",\"label\"=>\"Mode Transitions Passed\",\"value\"=>6,\"unit\"=>\"\",\"spec\"=>6,\"spec_operator\"=>\">=\",\"passed\"=>true)],\n282\t        artifacts=[Dict(\n283\t            \"kind\"=>\"table\",\"title\"=>\"Mode State Machine Transitions\",\n284\t            \"description\"=>\"All nominal ADS mode transitions verified per ADS Mode State Machine diagram\",\n285\t            \"data_file_name\"=>\"mode_transitions.csv\",\n286\t            \"table_columns\"=>[Dict(\"field\"=>\"from_mode\",\"label\"=>\"From Mode\"),Dict(\"field\"=>\"to_mode\",\"label\"=>\"To Mode\"),Dict(\"field\"=>\"trigger\",\"label\"=>\"Trigger\"),Dict(\"field\"=>\"passed\",\"label\"=>\"Pass\",\"is_pass_fail\"=>true)],\n287\t            \"inline_data\"=>[\n288\t                Dict(\"from_mode\"=>\"INIT\",\"to_mode\"=>\"COARSE_ACQ\",\"trigger\"=>\"sensors healthy\",\"passed\"=>true),\n289\t                Dict(\"from_mode\"=>\"COARSE_ACQ\",\"to_mode\"=>\"FINE_TRACK\",\"trigger\"=>\"ST locked + error<2 deg\",\"passed\"=>true),\n290\t                Dict(\"from_mode\"=>\"FINE_TRACK\",\"to_mode\"=>\"ECLIPSE\",\"trigger\"=>\"eclipse_entered\",\"passed\"=>true),\n291\t                Dict(\"from_mode\"=>\"ECLIPSE\",\"to_mode\"=>\"FINE_TRACK\",\"trigger\"=>\"eclipse_exited + ST healthy\",\"passed\"=>true),\n292\t                Dict(\"from_mode\"=>\"FINE_TRACK\",\"to_mode\"=>\"SAFE\",\"trigger\"=>\"gyro failure\",\"passed\"=>true),\n293\t                Dict(\"from_mode\"=>\"SAFE\",\"to_mode\"=>\"INIT\",\"trigger\"=>\"reset command\",\"passed\"=>true),\n294\t            ],\n295\t        )],\n296\t        summary=\"All 6 nominal mode transitions verified. ADS-SYS-004 PASS.\",\n297\t        passed=true\n298\t    )\n299\t  end\n300\t\n301\t  @testset \"Eclipse Mode (mag + gyro only)\" begin\n302\t    rng = MersenneTwister(77)\n303\t    q_true = [1.0,0.0,0.0,0.0]; q_init = perturb_quat(q_true, 1.0, rng)\n304\t    state = ads_mekf_init(q0=q_init, P0=1e-4*Matrix{Float64}(I,6,6))\n305\t    gyr = GyroModel(); mag = MagnetometerModel(noise_nT=50.0)\n306\t    B_I = [15000.0,0.0,35000.0]; omega = [0.001,0.0,0.0]\n307\t    R_m = 1e-4*Matrix{Float64}(I,3,3); Q = 1e-6*Matrix{Float64}(I,6,6)\n308\t    eclipse_errors = Float64[]\n309\t    for _ in 1:30\n310\t        dq = quat_from_axis_angle(normalize(omega), norm(omega))\n311\t        q_true = normalize(quat_multiply(q_true, dq))\n312\t        (om,_) = measure_gyro!(gyr, omega, 1.0)\n313\t        (b_m,ok) = measure_magnetometer(mag, q_true, B_I)\n314\t        ads_mekf_predict!(state, om, 1.0, Q)\n315\t        ok && ads_mekf_update_vector!(state, b_m, normalize(B_I), R_m)\n316\t        push!(eclipse_errors, attitude_error_deg(state, q_true))\n317\t    end\n318\t    err = eclipse_errors[end]\n319\t    ecl_pass = err < 2.0\n320\t    println(\"  Eclipse error after 30 s (mag+gyro): $(round(err,digits=3)) deg (spec <=0.5 1sigma)\")\n321\t    @test ecl_pass\n322\t    println(\"  Eclipse PASS\")\n323\t\n324\t    write_artifact(\"eclipse_error.csv\",\n325\t        \"step_s,error_deg\\n\" * join([\"$(i),$(round(eclipse_errors[i],digits=6))\" for i in eachindex(eclipse_errors)], \"\\n\") * \"\\n\")\n326\t\n327\t    emit_vnv(\n328\t        requirement_ids=[\"ADS-SYS-003\"],\n329\t        metrics=[Dict(\"name\"=>\"eclipse_attitude_error_deg\",\"label\"=>\"Eclipse Error (30 s)\",\"value\"=>round(err,digits=4),\"unit\"=>\"deg\",\"spec\"=>2.0,\"spec_operator\"=>\"<=\",\"passed\"=>ecl_pass)],\n330\t        artifacts=[Dict(\n331\t            \"kind\"=>\"plot\",\"title\"=>\"Eclipse Mode Attitude Error\",\n332\t            \"description\"=>\"Attitude error during eclipse using magnetometer + gyro only. 1-sigma spec: 0.5 deg.\",\n333\t            \"data_file_name\"=>\"eclipse_error.csv\",\n334\t            \"plot_spec\"=>Dict(\n335\t                \"type\"=>\"time-series\",\"title\"=>\"Eclipse Mode Error (mag+gyro)\",\n336\t                \"xAxis\"=>Dict(\"field\"=>\"step_s\",\"label\"=>\"Time\",\"unit\"=>\"s\"),\n337\t                \"yAxis\"=>Dict(\"field\"=>\"error_deg\",\"label\"=>\"Attitude Error\",\"unit\"=>\"deg\"),\n338\t                \"referenceLines\"=>[\n339\t                    Dict(\"value\"=>0.5,\"label\"=>\"ADS-SYS-003 spec (0.5 deg 1sigma)\",\"color\"=>\"#e74c3c\"),\n340\t                    Dict(\"value\"=>2.0,\"label\"=>\"4-sigma test bound\",\"color\"=>\"#ff9800\"),\n341\t                ],\n342\t            ),\n343\t        )],\n344\t        summary=\"Eclipse attitude error: $(round(err,digits=3)) deg after 30 s. ADS-SYS-003 PASS.\",\n345\t        passed=ecl_pass\n346\t    )\n347\t  end\n348\t\n349\tend\n350\tprintln(\"\\nAll ADS DRM 1 tests complete.\")\n351\t"}]},"parent_tool_use_id":null,"session_id":"9e34a2d1-41d8-4f77-b9b9-84a0a71e813e","uuid":"ab9bc7cc-9516-4587-8f40-573a203141d4","timestamp":"2026-06-23T02:18:44.950Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Robbie/falcon/SpaceAGORA.jl/test/gnc/ads_tests.jl","content":"# ADS Test Suite -- DRM 1 Verification\n# Requirements: ADS-VNV-001 (sensor statistics), ADS-VNV-002 (MEKF convergence),\n#               ADS-VNV-003 (filter consistency NEES)\n# Run: julia --startup-file=no test/gnc/ads_tests.jl\n#\n# Structured output: emits #VULCAN_VNV: <json> markers for Vulcan to parse.\n# Raw data: writes CSV files to $VULCAN_RUN_DIR/vnv-artifacts/ if set.\n\nusing Test, LinearAlgebra, Statistics, Random\n\nconst GNC_NAV = joinpath(@__DIR__, \"../../src/gnc/navigation\")\ninclude(joinpath(GNC_NAV, \"ads_sensor_models.jl\"))\ninclude(joinpath(GNC_NAV, \"ads_mekf.jl\"))\ninclude(joinpath(GNC_NAV, \"ads_mode_manager.jl\"))\n\n# -- Artifact output -----------------------------------------------------------\n\nconst ARTIFACTS_DIR = let\n    d = get(ENV, \"VULCAN_RUN_DIR\", \"\")\n    isempty(d) ? nothing : begin\n        adir = joinpath(d, \"vnv-artifacts\")\n        mkpath(adir)\n        adir\n    end\nend\n\nfunction write_artifact(filename::String, content::String)\n    ARTIFACTS_DIR === nothing && return filename\n    p = joinpath(ARTIFACTS_DIR, filename)\n    write(p, content)\n    return p\nend\n\n# Minimal JSON serializer (no external deps)\nfunction to_json(x)\n    if x isa AbstractDict\n        pairs_str = join([\"$(to_json(string(k))):$(to_json(v))\" for (k,v) in x], \",\")\n        return \"{$(pairs_str)}\"\n    elseif x isa AbstractVector\n        return \"[\" * join(map(to_json, x), \",\") * \"]\"\n    elseif x isa AbstractString\n        esc = replace(string(x), \"\\\\\" => \"\\\\\\\\\", \"\\\"\" => \"\\\\\\\"\", \"\\n\" => \"\\\\n\")\n        return \"\\\"$(esc)\\\"\"\n    elseif x === nothing || x === missing\n        return \"null\"\n    elseif x isa Bool\n        return x ? \"true\" : \"false\"\n    elseif x isa Number\n        return (isnan(x) || isinf(x)) ? \"null\" : string(x)\n    else\n        return \"\\\"$(string(x))\\\"\"\n    end\nend\n\nfunction emit_vnv(; requirement_ids, metrics, artifacts=[], summary, passed)\n    d = Dict(\n        \"requirement_ids\" => requirement_ids,\n        \"metrics\" => metrics,\n        \"artifacts\" => artifacts,\n        \"summary\" => summary,\n        \"passed\" => passed\n    )\n    println(\"#VULCAN_VNV: \" * to_json(d))\nend\n\n# -- Helpers -------------------------------------------------------------------\n\nrand_quat(rng=Random.GLOBAL_RNG) = normalize(randn(rng, 4))\n\nperturb_quat(q, deg, rng=Random.GLOBAL_RNG) =\n    normalize(quat_multiply(q, quat_from_axis_angle(normalize(randn(rng, 3)), deg*pi/180)))\n\nfunction run_mekf_sim(q_true_init, q_init, omega_true;\n                      dt=1.0, N=60, P0_scale=1e-2, rng=Random.GLOBAL_RNG,\n                      B_I=[15000.0,0.0,35000.0], sun_body=[1.0,0.0,0.0])\n    q_true = copy(q_true_init)\n    P0 = P0_scale * Matrix{Float64}(I, 6, 6)\n    state = ads_mekf_init(q0=q_init, P0=P0)\n    st = StarTrackerModel(); gyr = GyroModel(); mag = MagnetometerModel()\n    R_st = (5.0*pi/180/3600)^2 * Matrix{Float64}(I, 3, 3)\n    Q = 1e-6 * Matrix{Float64}(I, 6, 6)\n    errors = Float64[]; nees_vals = Float64[]\n    for _ in 1:N\n        th = norm(omega_true)*dt\n        dq = quat_from_axis_angle(normalize(omega_true), th)\n        q_true = normalize(quat_multiply(q_true, dq))\n        (om, _) = measure_gyro!(gyr, omega_true, dt)\n        (q_st, st_ok) = measure_star_tracker(st, q_true, sun_body, false)\n        ads_mekf_predict!(state, om, dt, Q)\n        st_ok && ads_mekf_update_star_tracker!(state, q_st, R_st)\n        push!(errors, attitude_error_deg(state, q_true))\n        push!(nees_vals, compute_nees(state, q_true))\n    end\n    (state, errors, nees_vals, q_true)\nend\n\n# -- Tests ---------------------------------------------------------------------\n\n@testset \"ADS DRM 1 -- Full Verification\" begin\n\n  @testset \"ADS-VNV-001 Sensor Noise Statistics\" begin\n    rng = MersenneTwister(42); N = 2000\n    q_id = [1.0,0.0,0.0,0.0]; B_I = [15000.0,0.0,35000.0]\n\n    st = StarTrackerModel(noise_arcsec=5.0)\n    st_errors = [begin\n        (q_m,ok) = measure_star_tracker(st, q_id, [1.0,0.0,0.0], false)\n        ok ? quat_angle_deg(q_id, q_m)*pi/180 : NaN\n    end for _ in 1:N]\n    st_errors = filter(!isnan, st_errors)\n    st_sigma_arcsec = std(st_errors)*180/pi*3600\n    st_pass = length(st_errors) > 0.9N && std(st_errors) < st.noise_sigma_rad*10\n    @test st_pass\n\n    mag = MagnetometerModel(noise_nT=50.0)\n    b_true = normalize(quat_rotate(q_id, B_I))\n    mag_angles = [begin\n        (b,ok) = measure_magnetometer(mag, q_id, B_I)\n        ok ? acos(clamp(dot(b,b_true),-1.0,1.0))*180/pi : NaN\n    end for _ in 1:N]\n    mag_angles = filter(!isnan, mag_angles)\n    mag_sigma_deg = std(mag_angles)\n    mag_pass = mag_sigma_deg < 2.0\n    @test mag_pass\n\n    sun = SunSensorModel(noise_deg=1.0, fov_deg=70.0)\n    sun_body_ref = quat_rotate(q_id, [0.0,0.0,1.0])\n    sun_angles = [begin\n        (s,ok) = measure_sun_sensor(sun, q_id, [0.0,0.0,1.0], false)\n        ok ? acos(clamp(dot(s,sun_body_ref),-1.0,1.0))*180/pi : NaN\n    end for _ in 1:N]\n    sun_angles = filter(!isnan, sun_angles)\n    sun_sigma_deg = std(sun_angles)\n    sun_pass = sun_sigma_deg < 5.0\n    @test sun_pass\n\n    println(\"  Star tracker noise sigma = $(round(st_sigma_arcsec,digits=2)) arcsec (spec 5)\")\n    println(\"  Magnetometer angular noise sigma = $(round(mag_sigma_deg,digits=3)) deg\")\n    println(\"  Sun sensor noise sigma = $(round(sun_sigma_deg,digits=3)) deg (spec 1)\")\n    println(\"  ADS-VNV-001 PASS\")\n\n    write_artifact(\"sensor_noise_stats.csv\",\n        \"sensor,measured_sigma,spec_sigma,unit,passed\\n\" *\n        \"star_tracker,$(round(st_sigma_arcsec,digits=3)),5.0,arcsec,$(st_pass)\\n\" *\n        \"magnetometer,$(round(mag_sigma_deg,digits=4)),2.0,deg,$(mag_pass)\\n\" *\n        \"sun_sensor,$(round(sun_sigma_deg,digits=4)),5.0,deg,$(sun_pass)\\n\")\n\n    emit_vnv(\n        requirement_ids=[\"ADS-VNV-001\",\"ADS-SNS-001\",\"ADS-SNS-002\",\"ADS-SNS-003\",\"ADS-SNS-004\"],\n        metrics=[\n            Dict(\"name\"=>\"star_tracker_noise_arcsec\",\"label\"=>\"Star Tracker Noise\",\"value\"=>round(st_sigma_arcsec,digits=3),\"unit\"=>\"arcsec\",\"spec\"=>5.0,\"spec_operator\"=>\"<=\",\"passed\"=>st_pass),\n            Dict(\"name\"=>\"magnetometer_noise_deg\",\"label\"=>\"Magnetometer Angular Noise\",\"value\"=>round(mag_sigma_deg,digits=4),\"unit\"=>\"deg\",\"spec\"=>2.0,\"spec_operator\"=>\"<=\",\"passed\"=>mag_pass),\n            Dict(\"name\"=>\"sun_sensor_noise_deg\",\"label\"=>\"Sun Sensor Angular Noise\",\"value\"=>round(sun_sigma_deg,digits=4),\"unit\"=>\"deg\",\"spec\"=>5.0,\"spec_operator\"=>\"<=\",\"passed\"=>sun_pass),\n        ],\n        artifacts=[Dict(\n            \"kind\"=>\"table\",\"title\"=>\"Sensor Noise Statistics\",\n            \"description\"=>\"Measured 1-sigma noise vs spec for each sensor model (N=$(N) trials each)\",\n            \"data_file_name\"=>\"sensor_noise_stats.csv\",\n            \"table_columns\"=>[\n                Dict(\"field\"=>\"sensor\",\"label\"=>\"Sensor\"),\n                Dict(\"field\"=>\"measured_sigma\",\"label\"=>\"Measured 1-sigma\"),\n                Dict(\"field\"=>\"spec_sigma\",\"label\"=>\"Spec\"),\n                Dict(\"field\"=>\"unit\",\"label\"=>\"Unit\"),\n                Dict(\"field\"=>\"passed\",\"label\"=>\"Pass\",\"is_pass_fail\"=>true),\n            ],\n            \"inline_data\"=>[\n                Dict(\"sensor\"=>\"Star Tracker\",\"measured_sigma\"=>round(st_sigma_arcsec,digits=3),\"spec_sigma\"=>5.0,\"unit\"=>\"arcsec\",\"passed\"=>st_pass),\n                Dict(\"sensor\"=>\"Magnetometer\",\"measured_sigma\"=>round(mag_sigma_deg,digits=4),\"spec_sigma\"=>2.0,\"unit\"=>\"deg\",\"passed\"=>mag_pass),\n                Dict(\"sensor\"=>\"Sun Sensor\",\"measured_sigma\"=>round(sun_sigma_deg,digits=4),\"spec_sigma\"=>5.0,\"unit\"=>\"deg\",\"passed\"=>sun_pass),\n            ],\n        )],\n        summary=\"Sensor noise: ST=$(round(st_sigma_arcsec,digits=2)) arcsec, Mag=$(round(mag_sigma_deg,digits=3)) deg, Sun=$(round(sun_sigma_deg,digits=3)) deg.\",\n        passed=st_pass && mag_pass && sun_pass\n    )\n  end\n\n  @testset \"ADS-VNV-002 MEKF Convergence from 5 deg\" begin\n    rng = MersenneTwister(123)\n    q_truth = [1.0,0.0,0.0,0.0]\n    q_init = perturb_quat(q_truth, 5.0, rng)\n    (_, errors, _, _) = run_mekf_sim(q_truth, q_init, [0.001,-0.0005,0.002]; N=60, rng=rng)\n    final_err = errors[end]\n    conv_pass = final_err < 0.1\n    println(\"  Attitude error after 60 s: $(round(final_err,digits=5)) deg (spec <=0.1)\")\n    @test conv_pass\n    println(\"  ADS-VNV-002 PASS\")\n\n    write_artifact(\"mekf_convergence.csv\",\n        \"step_s,error_deg\\n\" * join([\"$(i),$(round(errors[i],digits=6))\" for i in eachindex(errors)], \"\\n\") * \"\\n\")\n\n    emit_vnv(\n        requirement_ids=[\"ADS-VNV-002\",\"ADS-SYS-005\",\"ADS-FLT-001\"],\n        metrics=[Dict(\"name\"=>\"final_attitude_error_deg\",\"label\"=>\"Final Attitude Error\",\"value\"=>round(final_err,digits=6),\"unit\"=>\"deg\",\"spec\"=>0.1,\"spec_operator\"=>\"<=\",\"passed\"=>conv_pass)],\n        artifacts=[Dict(\n            \"kind\"=>\"plot\",\"title\"=>\"MEKF Convergence\",\n            \"description\"=>\"Attitude error vs time from 5 deg initial error. ST + gyro at 1 Hz.\",\n            \"data_file_name\"=>\"mekf_convergence.csv\",\n            \"plot_spec\"=>Dict(\n                \"type\"=>\"time-series\",\"title\"=>\"MEKF Convergence from 5 deg Initial Error\",\n                \"xAxis\"=>Dict(\"field\"=>\"step_s\",\"label\"=>\"Time\",\"unit\"=>\"s\"),\n                \"yAxis\"=>Dict(\"field\"=>\"error_deg\",\"label\"=>\"Attitude Error\",\"unit\"=>\"deg\"),\n                \"referenceLines\"=>[Dict(\"value\"=>0.1,\"label\"=>\"ADS-SYS-005 spec (0.1 deg)\",\"color\"=>\"#e74c3c\")],\n            ),\n        )],\n        summary=\"MEKF converges from 5 deg to $(round(final_err,digits=5)) deg in 60 s.\",\n        passed=conv_pass\n    )\n  end\n\n  @testset \"ADS-VNV-003 Filter Consistency NEES\" begin\n    N_trials = 100; all_nees = Float64[]\n    nees_rows = Tuple{Int,Int,Float64}[]\n    for trial in 1:N_trials\n        rng_t = MersenneTwister(trial+1000)\n        q_truth = rand_quat(rng_t)\n        q_init = perturb_quat(q_truth, 5.0*abs(randn(rng_t)), rng_t)\n        omega_t = 0.001 .* randn(rng_t, 3)\n        (_, _, nees_vals, _) = run_mekf_sim(q_truth, q_init, omega_t; N=40, P0_scale=1e-2, rng=rng_t)\n        for (s,n) in enumerate(nees_vals[11:end])\n            isfinite(n) || continue\n            push!(all_nees, n); push!(nees_rows, (trial, s+10, n))\n        end\n    end\n    frac = count(n->0.352<=n<=7.815, all_nees)/length(all_nees)\n    mu_nees = mean(all_nees)\n    cons_pass = frac>=0.50 && mu_nees<15.0\n    println(\"  NEES mean = $(round(mu_nees,digits=3)) (expected ~3.0 for chi2(3))\")\n    println(\"  Fraction in 95% CI: $(round(frac*100,digits=1))% (N=$(length(all_nees)))\")\n    @test cons_pass\n    println(\"  ADS-VNV-003 PASS\")\n\n    write_artifact(\"nees_distribution.csv\",\n        \"trial,step,nees\\n\" * join([\"$(t),$(s),$(round(n,digits=4))\" for (t,s,n) in nees_rows[1:min(end,2000)]], \"\\n\") * \"\\n\")\n    write_artifact(\"nees_summary.csv\",\n        \"metric,value\\nmean_nees,$(round(mu_nees,digits=4))\\nfrac_in_ci,$(round(frac,digits=4))\\nn_total,$(length(all_nees))\\n\")\n\n    emit_vnv(\n        requirement_ids=[\"ADS-VNV-003\",\"ADS-SYS-006\",\"ADS-FLT-003\"],\n        metrics=[\n            Dict(\"name\"=>\"nees_mean\",\"label\"=>\"NEES Mean\",\"value\"=>round(mu_nees,digits=4),\"unit\"=>\"\",\"spec\"=>nothing,\"spec_operator\"=>\"<=\",\"passed\"=>mu_nees<15.0),\n            Dict(\"name\"=>\"nees_ci_fraction\",\"label\"=>\"Fraction in 95% CI\",\"value\"=>round(frac,digits=4),\"unit\"=>\"\",\"spec\"=>0.50,\"spec_operator\"=>\">=\",\"passed\"=>frac>=0.50),\n        ],\n        artifacts=[\n            Dict(\"kind\"=>\"plot\",\"title\"=>\"NEES Distribution ($(N_trials) MC Trials)\",\"description\"=>\"chi^2(3) 95% CI: [0.352, 7.815]. Conservative filter: most samples near 0.\",\"data_file_name\"=>\"nees_distribution.csv\",\"plot_spec\"=>Dict(\"type\"=>\"histogram\",\"title\"=>\"NEES Distribution\",\"xAxis\"=>Dict(\"field\"=>\"nees\",\"label\"=>\"NEES\",\"unit\"=>\"\"),\"yAxis\"=>Dict(\"field\"=>\"count\",\"label\"=>\"Count\",\"unit\"=>\"\"),\"referenceLines\"=>[Dict(\"value\"=>0.352,\"label\"=>\"CI lower\",\"color\"=>\"#2196f3\"),Dict(\"value\"=>7.815,\"label\"=>\"CI upper\",\"color\"=>\"#2196f3\"),Dict(\"value\"=>3.0,\"label\"=>\"expected mean\",\"color\"=>\"#4caf50\")])),\n            Dict(\"kind\"=>\"table\",\"title\"=>\"NEES Consistency Summary\",\"description\"=>\"Filter consistency statistics from Monte Carlo\",\"data_file_name\"=>\"nees_summary.csv\",\"table_columns\"=>[Dict(\"field\"=>\"metric\",\"label\"=>\"Metric\"),Dict(\"field\"=>\"value\",\"label\"=>\"Value\")],\"inline_data\"=>[Dict(\"metric\"=>\"Mean NEES\",\"value\"=>round(mu_nees,digits=3)),Dict(\"metric\"=>\"Fraction in 95% CI\",\"value\"=>string(round(frac*100,digits=1))*\"%\"),Dict(\"metric\"=>\"N samples\",\"value\"=>length(all_nees))]),\n        ],\n        summary=\"NEES ($(N_trials) MC trials): mean=$(round(mu_nees,digits=3)), $(round(frac*100,digits=1))% in 95% CI.\",\n        passed=cons_pass\n    )\n  end\n\n  @testset \"Mode State Machine Transitions\" begin\n    all_ok = Dict(:star_tracker=>true,:gyro=>true,:magnetometer=>true,:sun_sensor=>true)\n    no_gyro = Dict(:star_tracker=>true,:gyro=>false,:magnetometer=>true,:sun_sensor=>true)\n    mgr = ads_mode_init()\n    @test mgr.current_mode == INIT\n    ads_mode_update!(mgr, all_ok, false, 0.0, 10.0); @test mgr.current_mode == COARSE_ACQ\n    ads_mode_update!(mgr, all_ok, false, 0.0, 1.0);  @test mgr.current_mode == FINE_TRACK\n    ads_mode_update!(mgr, all_ok, true,  0.0, 0.05); @test mgr.current_mode == ECLIPSE\n    ads_mode_update!(mgr, all_ok, false, 0.0, 0.05); @test mgr.current_mode == FINE_TRACK\n    ads_mode_update!(mgr, no_gyro, false, 0.0, 0.05); @test mgr.current_mode == SAFE\n    ads_mode_update!(mgr, all_ok, false, 0.0, 0.0, true); @test mgr.current_mode == INIT\n    mgr2 = ads_mode_init(); mgr2.current_mode = FINE_TRACK\n    @test :star_tracker in ads_mode_get_active_sensors(mgr2)\n    mgr3 = ads_mode_init(); mgr3.current_mode = ECLIPSE\n    @test :magnetometer in ads_mode_get_active_sensors(mgr3)\n    @test !(:star_tracker in ads_mode_get_active_sensors(mgr3))\n    println(\"  Mode state machine: all 6 transitions PASS\")\n\n    write_artifact(\"mode_transitions.csv\",\n        \"from_mode,to_mode,trigger,passed\\n\" *\n        \"INIT,COARSE_ACQ,sensors_healthy,true\\n\" *\n        \"COARSE_ACQ,FINE_TRACK,ST_locked_and_error_lt_2deg,true\\n\" *\n        \"FINE_TRACK,ECLIPSE,eclipse_entered,true\\n\" *\n        \"ECLIPSE,FINE_TRACK,eclipse_exited_and_ST_healthy,true\\n\" *\n        \"FINE_TRACK,SAFE,gyro_failure,true\\n\" *\n        \"SAFE,INIT,reset_command,true\\n\")\n\n    emit_vnv(\n        requirement_ids=[\"ADS-SYS-004\"],\n        metrics=[Dict(\"name\"=>\"mode_transitions_passed\",\"label\"=>\"Mode Transitions Passed\",\"value\"=>6,\"unit\"=>\"\",\"spec\"=>6,\"spec_operator\"=>\">=\",\"passed\"=>true)],\n        artifacts=[Dict(\n            \"kind\"=>\"table\",\"title\"=>\"Mode State Machine Transitions\",\n            \"description\"=>\"All nominal ADS mode transitions verified per ADS Mode State Machine diagram\",\n            \"data_file_name\"=>\"mode_transitions.csv\",\n            \"table_columns\"=>[Dict(\"field\"=>\"from_mode\",\"label\"=>\"From Mode\"),Dict(\"field\"=>\"to_mode\",\"label\"=>\"To Mode\"),Dict(\"field\"=>\"trigger\",\"label\"=>\"Trigger\"),Dict(\"field\"=>\"passed\",\"label\"=>\"Pass\",\"is_pass_fail\"=>true)],\n            \"inline_data\"=>[\n                Dict(\"from_mode\"=>\"INIT\",\"to_mode\"=>\"COARSE_ACQ\",\"trigger\"=>\"sensors healthy\",\"passed\"=>true),\n                Dict(\"from_mode\"=>\"COARSE_ACQ\",\"to_mode\"=>\"FINE_TRACK\",\"trigger\"=>\"ST locked + error<2 deg\",\"passed\"=>true),\n                Dict(\"from_mode\"=>\"FINE_TRACK\",\"to_mode\"=>\"ECLIPSE\",\"trigger\"=>\"eclipse_entered\",\"passed\"=>true),\n                Dict(\"from_mode\"=>\"ECLIPSE\",\"to_mode\"=>\"FINE_TRACK\",\"trigger\"=>\"eclipse_exited + ST healthy\",\"passed\"=>true),\n                Dict(\"from_mode\"=>\"FINE_TRACK\",\"to_mode\"=>\"SAFE\",\"trigger\"=>\"gyro failure\",\"passed\"=>true),\n                Dict(\"from_mode\"=>\"SAFE\",\"to_mode\"=>\"INIT\",\"trigger\"=>\"reset command\",\"passed\"=>true),\n            ],\n        )],\n        summary=\"All 6 nominal mode transitions verified. ADS-SYS-004 PASS.\",\n        passed=true\n    )\n  end\n\n  @testset \"Eclipse Mode (mag + gyro only)\" begin\n    rng = MersenneTwister(77)\n    q_true = [1.0,0.0,0.0,0.0]; q_init = perturb_quat(q_true, 1.0, rng)\n    state = ads_mekf_init(q0=q_init, P0=1e-4*Matrix{Float64}(I,6,6))\n    gyr = GyroModel(); mag = MagnetometerModel(noise_nT=50.0)\n    B_I = [15000.0,0.0,35000.0]; omega = [0.001,0.0,0.0]\n    R_m = 1e-4*Matrix{Float64}(I,3,3); Q = 1e-6*Matrix{Float64}(I,6,6)\n    eclipse_errors = Float64[]\n    for _ in 1:30\n        dq = quat_from_axis_angle(normalize(omega), norm(omega))\n        q_true = normalize(quat_multiply(q_true, dq))\n        (om,_) = measure_gyro!(gyr, omega, 1.0)\n        (b_m,ok) = measure_magnetometer(mag, q_true, B_I)\n        ads_mekf_predict!(state, om, 1.0, Q)\n        ok && ads_mekf_update_vector!(state, b_m, normalize(B_I), R_m)\n        push!(eclipse_errors, attitude_error_deg(state, q_true))\n    end\n    err = eclipse_errors[end]\n    ecl_pass = err < 2.0\n    println(\"  Eclipse error after 30 s (mag+gyro): $(round(err,digits=3)) deg (spec <=0.5 1sigma)\")\n    @test ecl_pass\n    println(\"  Eclipse PASS\")\n\n    write_artifact(\"eclipse_error.csv\",\n        \"step_s,error_deg\\n\" * join([\"$(i),$(round(eclipse_errors[i],digits=6))\" for i in eachindex(eclipse_errors)], \"\\n\") * \"\\n\")\n\n    emit_vnv(\n        requirement_ids=[\"ADS-SYS-003\"],\n        metrics=[Dict(\"name\"=>\"eclipse_attitude_error_deg\",\"label\"=>\"Eclipse Error (30 s)\",\"value\"=>round(err,digits=4),\"unit\"=>\"deg\",\"spec\"=>2.0,\"spec_operator\"=>\"<=\",\"passed\"=>ecl_pass)],\n        artifacts=[Dict(\n            \"kind\"=>\"plot\",\"title\"=>\"Eclipse Mode Attitude Error\",\n            \"description\"=>\"Attitude error during eclipse using magnetometer + gyro only. 1-sigma spec: 0.5 deg.\",\n            \"data_file_name\"=>\"eclipse_error.csv\",\n            \"plot_spec\"=>Dict(\n                \"type\"=>\"time-series\",\"title\"=>\"Eclipse Mode Error (mag+gyro)\",\n                \"xAxis\"=>Dict(\"field\"=>\"step_s\",\"label\"=>\"Time\",\"unit\"=>\"s\"),\n                \"yAxis\"=>Dict(\"field\"=>\"error_deg\",\"label\"=>\"Attitude Error\",\"unit\"=>\"deg\"),\n                \"referenceLines\"=>[\n                    Dict(\"value\"=>0.5,\"label\"=>\"ADS-SYS-003 spec (0.5 deg 1sigma)\",\"color\"=>\"#e74c3c\"),\n                    Dict(\"value\"=>2.0,\"label\"=>\"4-sigma test bound\",\"color\"=>\"#ff9800\"),\n                ],\n            ),\n        )],\n        summary=\"Eclipse attitude error: $(round(err,digits=3)) deg after 30 s. ADS-SYS-003 PASS.\",\n        passed=ecl_pass\n    )\n  end\n\nend\nprintln(\"\\nAll ADS DRM 1 tests complete.\")\n","numLines":351,"startLine":1,"totalLines":351}}}
