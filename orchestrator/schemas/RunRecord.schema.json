        "requested_constraints": {
          "additionalProperties": true,
          "title": "Requested Constraints",
          "type": "object"
        }
      },
      "required": [
        "objective"
      ],
      "title": "MissionIntent",
      "type": "object"
    },
    "OutputOptions": {
      "additionalProperties": false,
      "properties": {
        "results": {
          "default": true,
          "title": "Results",
          "type": "boolean"
        },
        "save_csv": {
          "default": true,
          "title": "Save Csv",
          "type": "boolean"
        },
        "generate_plots": {
          "default": false,
          "title": "Generate Plots",
          "type": "boolean"
        },
        "include_log_bundle": {
          "default": true,
          "title": "Include Log Bundle",
          "type": "boolean"
        }
      },
      "title": "OutputOptions",
      "type": "object"
    },
    "ResultSummary": {
      "additionalProperties": false,
      "properties": {
        "summary_text": {
          "title": "Summary Text",
          "type": "string"
        },
        "key_metrics": {
          "additionalProperties": true,
          "title": "Key Metrics",
          "type": "object"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/SourceCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "summary_text"
      ],
      "title": "ResultSummary",
      "type": "object"
    },
    "RunMode": {
      "enum": [
        "sync",
        "async"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "RunState": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "unsupported"
      ],
      "title": "RunState",
      "type": "string"
    },
    "SimulationModels": {
      "additionalProperties": false,
      "properties": {
        "gravity_model": {
          "default": "inverse_squared",
          "title": "Gravity Model",
          "type": "string"
        },
        "density_model": {
          "default": "gram",
          "title": "Density Model",
          "type": "string"
        },
        "thermal_model": {
          "default": "maxwellian",
          "title": "Thermal Model",
          "type": "string"
        },
        "aerodynamic_model": {
          "default": "mach_dependent",
          "title": "Aerodynamic Model",
          "type": "string"
        },
        "wind": {
          "default": true,
          "title": "Wind",
          "type": "boolean"
        },
        "srp": {
          "default": false,
          "title": "Srp",
          "type": "boolean"
        },
        "n_bodies": {
          "items": {
            "type": "string"
          },
          "title": "N Bodies",
          "type": "array"
        }
      },
      "title": "SimulationModels",
      "type": "object"
    },
    "SimulationSpec": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "default": "1.0",
          "title": "Spec Version",
          "type": "string"
        },
        "run_name": {
          "title": "Run Name",
          "type": "string"
        },
        "planet": {
          "title": "Planet",
          "type": "string"
        },
        "mission_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mission Name"
        },
        "mission_time_sec": {
          "title": "Mission Time Sec",
          "type": "number"
        },
        "entry_interface_km": {
          "default": 125.0,
          "title": "Entry Interface Km",
          "type": "number"
        },
        "initial_conditions": {
          "$ref": "#/$defs/InitialConditions"
        },
        "models": {
          "$ref": "#/$defs/SimulationModels"
        },
        "tolerances": {
          "$ref": "#/$defs/IntegrationTolerances"
        },
        "outputs": {
          "$ref": "#/$defs/OutputOptions"
        },
        "file_paths": {
          "$ref": "#/$defs/FilePaths"
        },
        "keplerian": {
          "default": false,
          "title": "Keplerian",
          "type": "boolean"
        },
        "orientation_sim": {
          "default": false,
          "title": "Orientation Sim",
          "type": "boolean"
        },
        "num_steps_to_save": {
          "default": 1000,
          "title": "Num Steps To Save",
          "type": "integer"
        }
      },
      "required": [
        "run_name",
        "planet",
        "mission_time_sec",
        "initial_conditions",
        "file_paths"
      ],
      "title": "SimulationSpec",
      "type": "object"
    },
    "SourceCitation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "SourceCitation",
      "type": "object"
    }
