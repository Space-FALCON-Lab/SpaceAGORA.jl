  "additionalProperties": false,
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunState"
    },
    "requested_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "effective_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
