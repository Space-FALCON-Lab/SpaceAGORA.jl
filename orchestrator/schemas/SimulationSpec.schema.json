  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "default": "1.0",
      "title": "Spec Version",
      "type": "string"
    },
    "run_name": {
      "title": "Run Name",
      "type": "string"
    },
    "planet": {
      "title": "Planet",
      "type": "string"
    },
    "mission_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Name"
    },
    "mission_time_sec": {
      "title": "Mission Time Sec",
      "type": "number"
    },
    "entry_interface_km": {
      "default": 125.0,
      "title": "Entry Interface Km",
      "type": "number"
    },
    "initial_conditions": {
      "$ref": "#/$defs/InitialConditions"
    },
    "models": {
      "$ref": "#/$defs/SimulationModels"
    },
    "tolerances": {
      "$ref": "#/$defs/IntegrationTolerances"
    },
    "outputs": {
      "$ref": "#/$defs/OutputOptions"
    },
    "file_paths": {
      "$ref": "#/$defs/FilePaths"
    },
    "keplerian": {
      "default": false,
      "title": "Keplerian",
      "type": "boolean"
    },
    "orientation_sim": {
      "default": false,
      "title": "Orientation Sim",
      "type": "boolean"
    },
    "num_steps_to_save": {
      "default": 1000,
      "title": "Num Steps To Save",
      "type": "integer"
    }
  },
  "required": [
    "run_name",
    "planet",
    "mission_time_sec",
    "initial_conditions",
    "file_paths"
