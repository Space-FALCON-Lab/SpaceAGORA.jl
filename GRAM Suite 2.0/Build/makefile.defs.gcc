### Set the Build Environment (C++, C, and FORTRAN compilers)
CXX := g++
CC := gcc
FC := gfortran
# Linker
LNK := gcc
FLNK := gcc

### Your preferred extension for executable (typically none on linux, .exe on Windows)
BINARY_EXTENSION :=
#BINARY_EXTENSION := .exe

### Set the Compiler Optimization Level (debug and release)
ifeq ($(BUILD),debug)
  OPT_FLAGS := -ggdb
else
  OPT_FLAGS := -O2
endif

### Set other Compiler Flags (C++, C, FORTRAN)
CXX_FLAGS := -std=c++11 -Wall -fPIC
CC_FLAGS := -std=c99 -Wall
FC_FLAGS := -std=f2003 -Wall -ffree-line-length-none
LNK_FLAGS := -lm -lstdc++ -pthread
FLNK_FLAGS := -lm -lstdc++ -pthread -lgfortran

### Relative Directory Locations (relative to makefiles in Build subdirectories)
BASE_DIR = ../..
COMMON_DIR := $(BASE_DIR)/common
OBJECT_DIR   = ./obj
TEST_OBJECT_DIR   = ./tobj
LIBRARY_DIR  = ../lib
BINARY_DIR = ../bin
MODULE_DIR = ../mod

### Set the location of the NAIF SPICE library
UNAME_M := $(shell uname -m)
SYSTEM_CSPICE := $(firstword $(wildcard \
  /usr/lib/libcspice.a \
  /usr/local/lib/libcspice.a \
  /usr/lib64/libcspice.a \
  /usr/lib/x86_64-linux-gnu/libcspice.a \
  /usr/lib/aarch64-linux-gnu/libcspice.a))

ifeq ($(UNAME_M),x86_64)
  ifneq ($(wildcard $(COMMON_DIR)/cspice/lib/cspice_linux_x86_64.a),)
    SPICE_LIB ?= $(COMMON_DIR)/cspice/lib/cspice_linux_x86_64.a
  else ifneq ($(wildcard $(COMMON_DIR)/cspice/lib/cspice_gcc85.a),)
    SPICE_LIB ?= $(COMMON_DIR)/cspice/lib/cspice_gcc85.a
  else ifneq ($(SYSTEM_CSPICE),)
    SPICE_LIB ?= $(SYSTEM_CSPICE)
  else
    SPICE_LIB ?= -lcspice
  endif
else ifeq ($(UNAME_M),aarch64)
  ifneq ($(wildcard $(COMMON_DIR)/cspice/lib/cspice_linux_aarch64.a),)
    SPICE_LIB ?= $(COMMON_DIR)/cspice/lib/cspice_linux_aarch64.a
  else ifneq ($(SYSTEM_CSPICE),)
    SPICE_LIB ?= $(SYSTEM_CSPICE)
  else
    SPICE_LIB ?= -lcspice
  endif
else ifeq ($(UNAME_M),arm64)
  ifneq ($(wildcard $(COMMON_DIR)/cspice/lib/cspice_linux_aarch64.a),)
    SPICE_LIB ?= $(COMMON_DIR)/cspice/lib/cspice_linux_aarch64.a
  else ifneq ($(SYSTEM_CSPICE),)
    SPICE_LIB ?= $(SYSTEM_CSPICE)
  else
    SPICE_LIB ?= -lcspice
  endif
else
  $(warning Unknown Linux architecture $(UNAME_M). Set SPICE_LIB manually.)
  ifneq ($(SYSTEM_CSPICE),)
    SPICE_LIB ?= $(SYSTEM_CSPICE)
  else
    SPICE_LIB ?= -lcspice
  endif
endif
