{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YUBtVf1g54cotX8uiwayGh","type":"tool_result","content":"1\t# Attitude Determination Subsystem — SpaceAGORA Navigation Effector\n2\t# DRM 1 | Requirements: ADS-SYS-001, ADS-INT-001, ADS-INT-002, ADS-INT-003\n3\t#\n4\t# Integration point: register as a calcNavigationEffect! effector.\n5\t# All sensor physics reuse existing SpaceAGORA models (no new environment code).\n6\t\n7\tinclude(\"ads_sensor_models.jl\")\n8\tinclude(\"ads_mekf.jl\")\n9\tinclude(\"ads_mode_manager.jl\")\n10\t\n11\t# ── Configuration ─────────────────────────────────────────────────────────────\n12\t\n13\tstruct ADSConfig\n14\t    update_rate_hz::Float64\n15\t    star_tracker_noise_arcsec::Float64\n16\t    gyro_arw_deg_sqrthr::Float64\n17\t    gyro_bias_instability_deg_hr::Float64\n18\t    mag_noise_nT::Float64\n19\t    sun_sensor_noise_deg::Float64\n20\t    nees_threshold::Float64\n21\t    star_tracker_fov_deg::Float64\n22\t    sun_sensor_fov_deg::Float64\n23\tend\n24\t\n25\tADSConfig() = ADSConfig(1.0, 5.0, 0.1, 1.0, 50.0, 1.0, 9.49, 15.0, 70.0)\n26\t\n27\t# ── Effector ──────────────────────────────────────────────────────────────────\n28\t\n29\tmutable struct ADSNavigationEffector\n30\t    config::ADSConfig\n31\t    star_tracker::StarTrackerModel\n32\t    gyro::GyroModel\n33\t    magnetometer::MagnetometerModel\n34\t    sun_sensor::SunSensorModel\n35\t    mekf::ADSMEKFState\n36\t    mode_mgr::ADSModeManager\n37\t    last_t::Float64\n38\t    initialized::Bool\n39\tend\n40\t\n41\tfunction ADSNavigationEffector(config::ADSConfig = ADSConfig())\n42\t    P0 = Diagonal([1e-3, 1e-3, 1e-3, 1e-5, 1e-5, 1e-5]) * 1.0\n43\t    ADSNavigationEffector(\n44\t        config,\n45\t        StarTrackerModel(noise_arcsec = config.star_tracker_noise_arcsec,\n46\t                         fov_deg      = config.star_tracker_fov_deg),\n47\t        GyroModel(arw_deg_sqrthr = config.gyro_arw_deg_sqrthr,\n48\t                  bias_deg_hr   = config.gyro_bias_instability_deg_hr),\n49\t        MagnetometerModel(noise_nT = config.mag_noise_nT),\n50\t        SunSensorModel(noise_deg = config.sun_sensor_noise_deg),\n51\t        ads_mekf_init(P0 = Matrix(P0)),\n52\t        ads_mode_init(nees_threshold = config.nees_threshold),\n53\t        0.0,\n54\t        false)\n55\tend\n56\t\n57\t# Noise matrices (built once per config)\n58\tfunction _Q(config::ADSConfig, dt::Float64)\n59\t    arw_var  = (config.gyro_arw_deg_sqrthr * π/180 / sqrt(3600.0))^2 / dt\n60\t    bias_var = (config.gyro_bias_instability_deg_hr * π/180 / 3600.0)^2 * dt\n61\t    Diagonal([arw_var, arw_var, arw_var, bias_var, bias_var, bias_var]) * 1.0\n62\tend\n63\t\n64\t_R_st(config::ADSConfig) =\n65\t    (config.star_tracker_noise_arcsec * π/180/3600)^2 * Matrix{Float64}(I, 3, 3)\n66\t\n67\t_R_mag(config::ADSConfig) =\n68\t    (config.mag_noise_nT / 50000e-9 * 1e-9 / 50000e-9)^2 * Matrix{Float64}(I, 3, 3)\n69\t\n70\t_R_sun(config::ADSConfig) =\n71\t    (config.sun_sensor_noise_deg * π/180)^2 * Matrix{Float64}(I, 3, 3)\n72\t\n73\t# ── calcNavigationEffect! hook ────────────────────────────────────────────────\n74\t\n75\t\"\"\"\n76\t    calcNavigationEffect!(effector::ADSNavigationEffector, model, u, p, t, sat_idx)\n77\t\n78\tSpaceAGORA navigation effector hook. ADS-INT-002.\n79\t\n80\tNOTE: Field names (model.body.roots[sat_idx].q, etc.) must match actual SpaceAGORA\n81\tmodel struct. Adapt if SpaceAGORA changes field naming conventions.\n82\t\"\"\"\n83\tfunction calcNavigationEffect!(effector::ADSNavigationEffector,\n84\t                                model, u, p, t::Float64, sat_idx::Int)\n85\t    dt = effector.initialized ?\n86\t        max(t - effector.last_t, 1e-6) :\n87\t        1.0 / effector.config.update_rate_hz\n88\t\n89\t    # ── Truth state (ADS-INT-003) ─────────────────────────────────────────────\n90\t    # Adapt these fields to the actual SpaceAGORA model struct:\n91\t    q_true    = collect(Float64, model.body.roots[sat_idx].q)\n92\t    ω_true    = collect(Float64, model.body.roots[sat_idx].omega)\n93\t\n94\t    # ── Reference vectors (reuse existing SpaceAGORA functions) ─────────────\n95\t    # These calls must match the actual SpaceAGORA API:\n96\t    sun_I_raw = get_sun_direction_inertial(model, t)        # from src/environment/ephemerides/\n97\t    B_I_raw   = get_magnetic_field_dipole(model, t, sat_idx) # from src/dynamics/coupled/perturbations.jl\n98\t    sun_I     = normalize(collect(Float64, sun_I_raw))\n99\t    B_I       = collect(Float64, B_I_raw)  # keep in nT for magnetometer noise model\n100\t\n101\t    # Eclipse flag — use existing SpaceAGORA eclipse detection\n102\t    eclipse = is_in_eclipse(model, t, sat_idx)\n103\t\n104\t    # ── Sensor measurements ───────────────────────────────────────────────────\n105\t    sun_body = quat_rotate(q_true, sun_I)\n106\t    (q_st,  st_valid)  = measure_star_tracker(effector.star_tracker,  q_true, sun_body, eclipse)\n107\t    (ω_meas, gyro_valid) = measure_gyro!(effector.gyro, ω_true, dt)\n108\t    (b_meas, mag_valid)  = measure_magnetometer(effector.magnetometer, q_true, B_I)\n109\t    (s_meas, sun_valid)  = measure_sun_sensor(effector.sun_sensor, q_true, sun_I, eclipse)\n110\t\n111\t    # ── Mode update ───────────────────────────────────────────────────────────\n112\t    health = Dict(:star_tracker => st_valid, :gyro => gyro_valid,\n113\t                  :magnetometer => mag_valid, :sun_sensor => sun_valid)\n114\t    nees = effector.initialized ? compute_nees(effector.mekf, q_true) : 0.0\n115\t    err  = effector.initialized ? attitude_error_deg(effector.mekf, q_true) : 180.0\n116\t    mode = ads_mode_update!(effector.mode_mgr, health, eclipse, nees, err)\n117\t    active = ads_mode_get_active_sensors(effector.mode_mgr)\n118\t\n119\t    # ── MEKF predict ──────────────────────────────────────────────────────────\n120\t    ads_mekf_predict!(effector.mekf, ω_meas, dt, Matrix(_Q(effector.config, dt)))\n121\t\n122\t    # ── MEKF update (active sensors only) ────────────────────────────────────\n123\t    :star_tracker ∈ active && st_valid &&\n124\t        ads_mekf_update_star_tracker!(effector.mekf, q_st, _R_st(effector.config))\n125\t    :magnetometer ∈ active && mag_valid &&\n126\t        ads_mekf_update_vector!(effector.mekf, b_meas, normalize(B_I), _R_mag(effector.config))\n127\t    :sun_sensor ∈ active && sun_valid &&\n128\t        ads_mekf_update_vector!(effector.mekf, s_meas, sun_I, _R_sun(effector.config))\n129\t\n130\t    # ── Output ────────────────────────────────────────────────────────────────\n131\t    valid = (mode != SAFE) && gyro_valid\n132\t    ω_est = ω_meas .- effector.mekf.gyro_bias\n133\t\n134\t    effector.last_t = t\n135\t    effector.initialized = true\n136\t\n137\t    # Return tuple; caller writes to NavigationEffect output struct\n138\t    return (effector.mekf.q_est, ω_est, valid, Int(mode))\n139\tend\n140\t\n141\t\"\"\"\n142\t    register_ads_navigation!(sim_config; config=ADSConfig()) -> ADSNavigationEffector\n143\t\n144\tRegister ADS effector with SpaceAGORA SimulationConfiguration. ADS-INT-002.\n145\t\"\"\"\n146\tfunction register_ads_navigation!(sim_config; config::ADSConfig = ADSConfig())\n147\t    effector = ADSNavigationEffector(config)\n148\t    # Adapt to actual SpaceAGORA registration API:\n149\t    # push!(sim_config.navigation_effectors, (effector, 1.0 / config.update_rate_hz))\n150\t    return effector\n151\tend\n152\t\n153\t"}]},"parent_tool_use_id":null,"session_id":"9e34a2d1-41d8-4f77-b9b9-84a0a71e813e","uuid":"322f3bff-1b7e-4bb5-9ffc-3f74a45a9383","timestamp":"2026-06-23T02:18:35.029Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Robbie/falcon/SpaceAGORA.jl/src/gnc/navigation/ads_navigation_effector.jl","content":"# Attitude Determination Subsystem — SpaceAGORA Navigation Effector\n# DRM 1 | Requirements: ADS-SYS-001, ADS-INT-001, ADS-INT-002, ADS-INT-003\n#\n# Integration point: register as a calcNavigationEffect! effector.\n# All sensor physics reuse existing SpaceAGORA models (no new environment code).\n\ninclude(\"ads_sensor_models.jl\")\ninclude(\"ads_mekf.jl\")\ninclude(\"ads_mode_manager.jl\")\n\n# ── Configuration ─────────────────────────────────────────────────────────────\n\nstruct ADSConfig\n    update_rate_hz::Float64\n    star_tracker_noise_arcsec::Float64\n    gyro_arw_deg_sqrthr::Float64\n    gyro_bias_instability_deg_hr::Float64\n    mag_noise_nT::Float64\n    sun_sensor_noise_deg::Float64\n    nees_threshold::Float64\n    star_tracker_fov_deg::Float64\n    sun_sensor_fov_deg::Float64\nend\n\nADSConfig() = ADSConfig(1.0, 5.0, 0.1, 1.0, 50.0, 1.0, 9.49, 15.0, 70.0)\n\n# ── Effector ──────────────────────────────────────────────────────────────────\n\nmutable struct ADSNavigationEffector\n    config::ADSConfig\n    star_tracker::StarTrackerModel\n    gyro::GyroModel\n    magnetometer::MagnetometerModel\n    sun_sensor::SunSensorModel\n    mekf::ADSMEKFState\n    mode_mgr::ADSModeManager\n    last_t::Float64\n    initialized::Bool\nend\n\nfunction ADSNavigationEffector(config::ADSConfig = ADSConfig())\n    P0 = Diagonal([1e-3, 1e-3, 1e-3, 1e-5, 1e-5, 1e-5]) * 1.0\n    ADSNavigationEffector(\n        config,\n        StarTrackerModel(noise_arcsec = config.star_tracker_noise_arcsec,\n                         fov_deg      = config.star_tracker_fov_deg),\n        GyroModel(arw_deg_sqrthr = config.gyro_arw_deg_sqrthr,\n                  bias_deg_hr   = config.gyro_bias_instability_deg_hr),\n        MagnetometerModel(noise_nT = config.mag_noise_nT),\n        SunSensorModel(noise_deg = config.sun_sensor_noise_deg),\n        ads_mekf_init(P0 = Matrix(P0)),\n        ads_mode_init(nees_threshold = config.nees_threshold),\n        0.0,\n        false)\nend\n\n# Noise matrices (built once per config)\nfunction _Q(config::ADSConfig, dt::Float64)\n    arw_var  = (config.gyro_arw_deg_sqrthr * π/180 / sqrt(3600.0))^2 / dt\n    bias_var = (config.gyro_bias_instability_deg_hr * π/180 / 3600.0)^2 * dt\n    Diagonal([arw_var, arw_var, arw_var, bias_var, bias_var, bias_var]) * 1.0\nend\n\n_R_st(config::ADSConfig) =\n    (config.star_tracker_noise_arcsec * π/180/3600)^2 * Matrix{Float64}(I, 3, 3)\n\n_R_mag(config::ADSConfig) =\n    (config.mag_noise_nT / 50000e-9 * 1e-9 / 50000e-9)^2 * Matrix{Float64}(I, 3, 3)\n\n_R_sun(config::ADSConfig) =\n    (config.sun_sensor_noise_deg * π/180)^2 * Matrix{Float64}(I, 3, 3)\n\n# ── calcNavigationEffect! hook ────────────────────────────────────────────────\n\n\"\"\"\n    calcNavigationEffect!(effector::ADSNavigationEffector, model, u, p, t, sat_idx)\n\nSpaceAGORA navigation effector hook. ADS-INT-002.\n\nNOTE: Field names (model.body.roots[sat_idx].q, etc.) must match actual SpaceAGORA\nmodel struct. Adapt if SpaceAGORA changes field naming conventions.\n\"\"\"\nfunction calcNavigationEffect!(effector::ADSNavigationEffector,\n                                model, u, p, t::Float64, sat_idx::Int)\n    dt = effector.initialized ?\n        max(t - effector.last_t, 1e-6) :\n        1.0 / effector.config.update_rate_hz\n\n    # ── Truth state (ADS-INT-003) ─────────────────────────────────────────────\n    # Adapt these fields to the actual SpaceAGORA model struct:\n    q_true    = collect(Float64, model.body.roots[sat_idx].q)\n    ω_true    = collect(Float64, model.body.roots[sat_idx].omega)\n\n    # ── Reference vectors (reuse existing SpaceAGORA functions) ─────────────\n    # These calls must match the actual SpaceAGORA API:\n    sun_I_raw = get_sun_direction_inertial(model, t)        # from src/environment/ephemerides/\n    B_I_raw   = get_magnetic_field_dipole(model, t, sat_idx) # from src/dynamics/coupled/perturbations.jl\n    sun_I     = normalize(collect(Float64, sun_I_raw))\n    B_I       = collect(Float64, B_I_raw)  # keep in nT for magnetometer noise model\n\n    # Eclipse flag — use existing SpaceAGORA eclipse detection\n    eclipse = is_in_eclipse(model, t, sat_idx)\n\n    # ── Sensor measurements ───────────────────────────────────────────────────\n    sun_body = quat_rotate(q_true, sun_I)\n    (q_st,  st_valid)  = measure_star_tracker(effector.star_tracker,  q_true, sun_body, eclipse)\n    (ω_meas, gyro_valid) = measure_gyro!(effector.gyro, ω_true, dt)\n    (b_meas, mag_valid)  = measure_magnetometer(effector.magnetometer, q_true, B_I)\n    (s_meas, sun_valid)  = measure_sun_sensor(effector.sun_sensor, q_true, sun_I, eclipse)\n\n    # ── Mode update ───────────────────────────────────────────────────────────\n    health = Dict(:star_tracker => st_valid, :gyro => gyro_valid,\n                  :magnetometer => mag_valid, :sun_sensor => sun_valid)\n    nees = effector.initialized ? compute_nees(effector.mekf, q_true) : 0.0\n    err  = effector.initialized ? attitude_error_deg(effector.mekf, q_true) : 180.0\n    mode = ads_mode_update!(effector.mode_mgr, health, eclipse, nees, err)\n    active = ads_mode_get_active_sensors(effector.mode_mgr)\n\n    # ── MEKF predict ──────────────────────────────────────────────────────────\n    ads_mekf_predict!(effector.mekf, ω_meas, dt, Matrix(_Q(effector.config, dt)))\n\n    # ── MEKF update (active sensors only) ────────────────────────────────────\n    :star_tracker ∈ active && st_valid &&\n        ads_mekf_update_star_tracker!(effector.mekf, q_st, _R_st(effector.config))\n    :magnetometer ∈ active && mag_valid &&\n        ads_mekf_update_vector!(effector.mekf, b_meas, normalize(B_I), _R_mag(effector.config))\n    :sun_sensor ∈ active && sun_valid &&\n        ads_mekf_update_vector!(effector.mekf, s_meas, sun_I, _R_sun(effector.config))\n\n    # ── Output ────────────────────────────────────────────────────────────────\n    valid = (mode != SAFE) && gyro_valid\n    ω_est = ω_meas .- effector.mekf.gyro_bias\n\n    effector.last_t = t\n    effector.initialized = true\n\n    # Return tuple; caller writes to NavigationEffect output struct\n    return (effector.mekf.q_est, ω_est, valid, Int(mode))\nend\n\n\"\"\"\n    register_ads_navigation!(sim_config; config=ADSConfig()) -> ADSNavigationEffector\n\nRegister ADS effector with SpaceAGORA SimulationConfiguration. ADS-INT-002.\n\"\"\"\nfunction register_ads_navigation!(sim_config; config::ADSConfig = ADSConfig())\n    effector = ADSNavigationEffector(config)\n    # Adapt to actual SpaceAGORA registration API:\n    # push!(sim_config.navigation_effectors, (effector, 1.0 / config.update_rate_hz))\n    return effector\nend\n\n","numLines":153,"startLine":1,"totalLines":153}}}
