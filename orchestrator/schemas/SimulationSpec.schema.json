          "type": "number"
        },
        "abstol_orbit": {
          "default": 1e-07,
          "title": "Abstol Orbit",
          "type": "number"
        },
        "reltol_atmosphere": {
          "default": 1e-07,
          "title": "Reltol Atmosphere",
          "type": "number"
        },
        "abstol_atmosphere": {
          "default": 1e-09,
          "title": "Abstol Atmosphere",
          "type": "number"
        },
        "dt_max_orbit": {
          "default": 30.0,
          "title": "Dt Max Orbit",
          "type": "number"
        },
        "dt_max_atmosphere": {
          "default": 1.0,
          "title": "Dt Max Atmosphere",
          "type": "number"
        }
      },
      "title": "IntegrationTolerances",
      "type": "object"
    },
    "OutputOptions": {
      "additionalProperties": false,
      "properties": {
        "results": {
          "default": true,
          "title": "Results",
          "type": "boolean"
        },
        "save_csv": {
          "default": true,
          "title": "Save Csv",
          "type": "boolean"
        },
        "generate_plots": {
          "default": false,
          "title": "Generate Plots",
          "type": "boolean"
        },
        "include_log_bundle": {
          "default": true,
          "title": "Include Log Bundle",
          "type": "boolean"
        }
      },
      "title": "OutputOptions",
      "type": "object"
    },
    "SimulationModels": {
      "additionalProperties": false,
      "properties": {
        "gravity_model": {
          "default": "inverse_squared",
