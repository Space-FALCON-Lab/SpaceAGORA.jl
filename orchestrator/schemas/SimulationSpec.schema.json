        "spice": {
          "title": "Spice",
          "type": "string"
        },
        "gram_data": {
          "title": "Gram Data",
          "type": "string"
        },
        "gram_py": {
          "title": "Gram Py",
          "type": "string"
        }
      },
      "required": [
        "spice",
        "gram_data",
        "gram_py"
      ],
      "title": "FilePaths",
      "type": "object"
    },
    "InitialConditions": {
      "additionalProperties": false,
      "properties": {
        "ra_m": {
          "title": "Ra M",
          "type": "number"
        },
        "rp_m": {
          "title": "Rp M",
          "type": "number"
        },
        "i_deg": {
          "title": "I Deg",
          "type": "number"
        },
        "argument_of_periapsis_deg": {
          "title": "Argument Of Periapsis Deg",
          "type": "number"
        },
        "raan_deg": {
          "title": "Raan Deg",
          "type": "number"
        },
        "true_anomaly_deg": {
          "default": 180.0,
          "title": "True Anomaly Deg",
          "type": "number"
        }
      },
      "required": [
        "ra_m",
        "rp_m",
        "i_deg",
        "argument_of_periapsis_deg",
        "raan_deg"
      ],
      "title": "InitialConditions",
      "type": "object"
    },
