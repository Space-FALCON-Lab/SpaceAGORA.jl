        "mission_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mission Name"
        },
        "planet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planet"
        },
        "replicate_mission": {
          "default": false,
          "title": "Replicate Mission",
          "type": "boolean"
