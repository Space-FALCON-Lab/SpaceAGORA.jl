    "spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimulationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capability_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/SourceCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
