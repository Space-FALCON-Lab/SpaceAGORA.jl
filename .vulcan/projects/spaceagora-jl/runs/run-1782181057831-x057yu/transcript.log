{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y7hnP4UbfEejz7yydGcm2c","type":"tool_result","content":"1\t# Attitude Determination Subsystem — Operational Mode Manager\n2\t# DRM 1 | Requirements: ADS-SYS-004\n3\t# Implements mode state machine from ADS — Mode State Machine sheet\n4\t\n5\t@enum ADSMode::Int8 INIT=1 COARSE_ACQ=2 FINE_TRACK=3 ECLIPSE=4 SAFE=5\n6\t\n7\tmutable struct ADSModeManager\n8\t    current_mode::ADSMode\n9\t    nees_threshold::Float64\n10\t    fine_track_error_threshold_deg::Float64\n11\tend\n12\t\n13\tfunction ads_mode_init(;\n14\t    nees_threshold::Float64 = 9.49,\n15\t    fine_track_threshold_deg::Float64 = 2.0)\n16\t    ADSModeManager(INIT, nees_threshold, fine_track_threshold_deg)\n17\tend\n18\t\n19\t\"\"\"\n20\t    ads_mode_update!(mgr, sensor_health, eclipse_flag, nees, error_deg, reset=false)\n21\t\n22\tAdvance the ADS mode state machine. Returns updated mode.\n23\t\"\"\"\n24\tfunction ads_mode_update!(mgr::ADSModeManager,\n25\t                           sensor_health::Dict{Symbol,Bool},\n26\t                           eclipse_flag::Bool,\n27\t                           nees::Float64,\n28\t                           error_deg::Float64,\n29\t                           reset_command::Bool = false)\n30\t    gyro_ok = get(sensor_health, :gyro, false)\n31\t    st_ok   = get(sensor_health, :star_tracker, false)\n32\t    mag_ok  = get(sensor_health, :magnetometer, false)\n33\t    sun_ok  = get(sensor_health, :sun_sensor, false)\n34\t\n35\t    # Priority: fault → SAFE (from any state except SAFE)\n36\t    if !gyro_ok && mgr.current_mode != SAFE\n37\t        mgr.current_mode = SAFE\n38\t        return mgr.current_mode\n39\t    end\n40\t    if nees > mgr.nees_threshold && mgr.current_mode ∈ (FINE_TRACK, ECLIPSE)\n41\t        mgr.current_mode = SAFE\n42\t        return mgr.current_mode\n43\t    end\n44\t\n45\t    if mgr.current_mode == INIT\n46\t        (gyro_ok && (mag_ok || sun_ok)) && (mgr.current_mode = COARSE_ACQ)\n47\t\n48\t    elseif mgr.current_mode == COARSE_ACQ\n49\t        if eclipse_flag\n50\t            mgr.current_mode = ECLIPSE\n51\t        elseif st_ok && error_deg < mgr.fine_track_error_threshold_deg\n52\t            mgr.current_mode = FINE_TRACK\n53\t        end\n54\t\n55\t    elseif mgr.current_mode == FINE_TRACK\n56\t        eclipse_flag && (mgr.current_mode = ECLIPSE)\n57\t\n58\t    elseif mgr.current_mode == ECLIPSE\n59\t        if !eclipse_flag\n60\t            mgr.current_mode = st_ok ? FINE_TRACK : COARSE_ACQ\n61\t        end\n62\t\n63\t    elseif mgr.current_mode == SAFE\n64\t        reset_command && (mgr.current_mode = INIT)\n65\t    end\n66\t\n67\t    return mgr.current_mode\n68\tend\n69\t\n70\t\"\"\"Returns sensor symbols to use in MEKF update for the current mode.\"\"\"\n71\tfunction ads_mode_get_active_sensors(mgr::ADSModeManager)\n72\t    mgr.current_mode == FINE_TRACK  && return [:star_tracker, :gyro]\n73\t    mgr.current_mode == ECLIPSE     && return [:gyro, :magnetometer]\n74\t    mgr.current_mode == COARSE_ACQ  && return [:magnetometer, :sun_sensor]\n75\t    return Symbol[]\n76\tend\n77\t\n78\t"}]},"parent_tool_use_id":null,"session_id":"9e34a2d1-41d8-4f77-b9b9-84a0a71e813e","uuid":"374777aa-3805-47a2-b895-116081881abf","timestamp":"2026-06-23T02:18:22.370Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Robbie/falcon/SpaceAGORA.jl/src/gnc/navigation/ads_mode_manager.jl","content":"# Attitude Determination Subsystem — Operational Mode Manager\n# DRM 1 | Requirements: ADS-SYS-004\n# Implements mode state machine from ADS — Mode State Machine sheet\n\n@enum ADSMode::Int8 INIT=1 COARSE_ACQ=2 FINE_TRACK=3 ECLIPSE=4 SAFE=5\n\nmutable struct ADSModeManager\n    current_mode::ADSMode\n    nees_threshold::Float64\n    fine_track_error_threshold_deg::Float64\nend\n\nfunction ads_mode_init(;\n    nees_threshold::Float64 = 9.49,\n    fine_track_threshold_deg::Float64 = 2.0)\n    ADSModeManager(INIT, nees_threshold, fine_track_threshold_deg)\nend\n\n\"\"\"\n    ads_mode_update!(mgr, sensor_health, eclipse_flag, nees, error_deg, reset=false)\n\nAdvance the ADS mode state machine. Returns updated mode.\n\"\"\"\nfunction ads_mode_update!(mgr::ADSModeManager,\n                           sensor_health::Dict{Symbol,Bool},\n                           eclipse_flag::Bool,\n                           nees::Float64,\n                           error_deg::Float64,\n                           reset_command::Bool = false)\n    gyro_ok = get(sensor_health, :gyro, false)\n    st_ok   = get(sensor_health, :star_tracker, false)\n    mag_ok  = get(sensor_health, :magnetometer, false)\n    sun_ok  = get(sensor_health, :sun_sensor, false)\n\n    # Priority: fault → SAFE (from any state except SAFE)\n    if !gyro_ok && mgr.current_mode != SAFE\n        mgr.current_mode = SAFE\n        return mgr.current_mode\n    end\n    if nees > mgr.nees_threshold && mgr.current_mode ∈ (FINE_TRACK, ECLIPSE)\n        mgr.current_mode = SAFE\n        return mgr.current_mode\n    end\n\n    if mgr.current_mode == INIT\n        (gyro_ok && (mag_ok || sun_ok)) && (mgr.current_mode = COARSE_ACQ)\n\n    elseif mgr.current_mode == COARSE_ACQ\n        if eclipse_flag\n            mgr.current_mode = ECLIPSE\n        elseif st_ok && error_deg < mgr.fine_track_error_threshold_deg\n            mgr.current_mode = FINE_TRACK\n        end\n\n    elseif mgr.current_mode == FINE_TRACK\n        eclipse_flag && (mgr.current_mode = ECLIPSE)\n\n    elseif mgr.current_mode == ECLIPSE\n        if !eclipse_flag\n            mgr.current_mode = st_ok ? FINE_TRACK : COARSE_ACQ\n        end\n\n    elseif mgr.current_mode == SAFE\n        reset_command && (mgr.current_mode = INIT)\n    end\n\n    return mgr.current_mode\nend\n\n\"\"\"Returns sensor symbols to use in MEKF update for the current mode.\"\"\"\nfunction ads_mode_get_active_sensors(mgr::ADSModeManager)\n    mgr.current_mode == FINE_TRACK  && return [:star_tracker, :gyro]\n    mgr.current_mode == ECLIPSE     && return [:gyro, :magnetometer]\n    mgr.current_mode == COARSE_ACQ  && return [:magnetometer, :sun_sensor]\n    return Symbol[]\nend\n\n","numLines":78,"startLine":1,"totalLines":78}}}
