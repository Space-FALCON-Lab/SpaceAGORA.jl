{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "content_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CapabilityReport": {
      "additionalProperties": false,
      "properties": {
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "unsupported_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Reasons",
          "type": "array"
        },
        "nearest_supported_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimulationSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forced_overrides": {
          "additionalProperties": true,
          "title": "Forced Overrides",
          "type": "object"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "reroute_to_async": {
          "default": false,
          "title": "Reroute To Async",
          "type": "boolean"
        }
      },
      "required": [
        "supported"
      ],
      "title": "CapabilityReport",
      "type": "object"
    },
    "FilePaths": {
      "additionalProperties": false,
      "properties": {
        "spice": {
          "title": "Spice",
          "type": "string"
        },
        "gram_data": {
          "title": "Gram Data",
          "type": "string"
        },
        "gram_py": {
          "title": "Gram Py",
          "type": "string"
        }
      },
      "required": [
        "spice",
        "gram_data",
        "gram_py"
      ],
      "title": "FilePaths",
      "type": "object"
    },
    "InitialConditions": {
      "additionalProperties": false,
      "properties": {
        "ra_m": {
          "title": "Ra M",
          "type": "number"
        },
        "rp_m": {
          "title": "Rp M",
          "type": "number"
        },
        "i_deg": {
          "title": "I Deg",
          "type": "number"
        },
        "argument_of_periapsis_deg": {
          "title": "Argument Of Periapsis Deg",
          "type": "number"
        },
        "raan_deg": {
          "title": "Raan Deg",
          "type": "number"
        },
        "true_anomaly_deg": {
          "default": 180.0,
          "title": "True Anomaly Deg",
          "type": "number"
        }
      },
      "required": [
        "ra_m",
        "rp_m",
        "i_deg",
        "argument_of_periapsis_deg",
        "raan_deg"
      ],
      "title": "InitialConditions",
      "type": "object"
    },
    "IntegrationTolerances": {
      "additionalProperties": false,
      "properties": {
        "reltol_orbit": {
          "default": 1e-06,
          "title": "Reltol Orbit",
          "type": "number"
        },
        "abstol_orbit": {
          "default": 1e-07,
          "title": "Abstol Orbit",
          "type": "number"
        },
        "reltol_atmosphere": {
          "default": 1e-07,
          "title": "Reltol Atmosphere",
          "type": "number"
        },
        "abstol_atmosphere": {
          "default": 1e-09,
          "title": "Abstol Atmosphere",
          "type": "number"
        },
        "dt_max_orbit": {
          "default": 30.0,
          "title": "Dt Max Orbit",
          "type": "number"
        },
        "dt_max_atmosphere": {
          "default": 1.0,
          "title": "Dt Max Atmosphere",
          "type": "number"
        }
      },
      "title": "IntegrationTolerances",
      "type": "object"
    },
    "MissionIntent": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "title": "Objective",
          "type": "string"
