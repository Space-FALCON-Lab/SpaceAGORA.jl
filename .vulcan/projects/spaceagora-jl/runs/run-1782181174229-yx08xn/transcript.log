{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018MFeri69g2AXsXgXXdfos7","type":"tool_result","content":"1\t# Attitude Determination Subsystem — Sensor Measurement Models\n2\t# DRM 1 | Requirements: ADS-SNS-001 through ADS-SNS-004\n3\t# Implements measurement models for: StarTracker, Gyroscope, Magnetometer, SunSensor\n4\t\n5\t# Quaternion convention: [w, x, y, z] (scalar first)\n6\t\n7\t# ── Star Tracker Model ────────────────────────────────────────────────────────\n8\t\n9\tstruct StarTrackerModel\n10\t    noise_sigma_rad::Float64      # per-axis 1σ noise (rad)\n11\t    fov_half_angle_rad::Float64   # field-of-view half-angle (rad)\n12\t    sun_exclusion_rad::Float64    # minimum sun angle (rad)\n13\tend\n14\t\n15\tfunction StarTrackerModel(;\n16\t    noise_arcsec::Float64 = 5.0,\n17\t    fov_deg::Float64 = 15.0,\n18\t    sun_exclusion_deg::Float64 = 30.0)\n19\t    StarTrackerModel(\n20\t        noise_arcsec * π / (180.0 * 3600.0),\n21\t        fov_deg * π / 180.0,\n22\t        sun_exclusion_deg * π / 180.0)\n23\tend\n24\t\n25\t\"\"\"\n26\t    measure_star_tracker(model, q_true, sun_dir_body, eclipse_flag)\n27\t\n28\tReturn (q_meas, is_valid). ADS-SNS-001.\n29\t\"\"\"\n30\tfunction measure_star_tracker(model::StarTrackerModel,\n31\t                               q_true::AbstractVector,\n32\t                               sun_dir_body::AbstractVector,\n33\t                               eclipse_flag::Bool)\n34\t    eclipse_flag && return (copy(q_true), false)\n35\t\n36\t    # Sun exclusion check\n37\t    s = normalize(sun_dir_body)\n38\t    boresight = [0.0, 0.0, 1.0]\n39\t    cos_angle = clamp(dot(s, boresight), -1.0, 1.0)\n40\t    abs(acos(cos_angle)) < model.sun_exclusion_rad && return (copy(q_true), false)\n41\t\n42\t    # Add small rotation noise\n43\t    noise_axis = normalize(randn(3))\n44\t    noise_angle = model.noise_sigma_rad * randn()\n45\t    half = noise_angle / 2\n46\t    δq = [cos(half); noise_axis .* sin(half)]\n47\t    q_meas = quat_multiply(q_true, δq)\n48\t    return (normalize(q_meas), true)\n49\tend\n50\t\n51\t# ── Gyroscope Model ───────────────────────────────────────────────────────────\n52\t\n53\tmutable struct GyroModel\n54\t    arw_sigma::Float64        # angle random walk σ per root-Hz (rad/s/√Hz)\n55\t    bias_sigma::Float64       # bias random walk σ per step (rad/s)\n56\t    bias::Vector{Float64}     # current bias (truth, rad/s)\n57\tend\n58\t\n59\tfunction GyroModel(;\n60\t    arw_deg_sqrthr::Float64 = 0.1,\n61\t    bias_deg_hr::Float64 = 1.0)\n62\t    arw = arw_deg_sqrthr * π / 180.0 / sqrt(3600.0)\n63\t    bias_rw = bias_deg_hr * π / 180.0 / 3600.0\n64\t    GyroModel(arw, bias_rw, zeros(3))\n65\tend\n66\t\n67\t\"\"\"\n68\t    measure_gyro!(model, omega_true, dt) -> (omega_meas, is_valid)\n69\t\n70\tADS-SNS-002.\n71\t\"\"\"\n72\tfunction measure_gyro!(model::GyroModel, omega_true::AbstractVector, dt::Float64)\n73\t    arw_noise = (model.arw_sigma / sqrt(dt)) .* randn(3)\n74\t    model.bias .+= model.bias_sigma .* sqrt(dt) .* randn(3)\n75\t    return (omega_true .+ model.bias .+ arw_noise, true)\n76\tend\n77\t\n78\t# ── Magnetometer Model ────────────────────────────────────────────────────────\n79\t\n80\tstruct MagnetometerModel\n81\t    noise_nT::Float64    # per-axis 1σ noise (nT)\n82\tend\n83\tMagnetometerModel(; noise_nT::Float64 = 50.0) = MagnetometerModel(noise_nT)\n84\t\n85\t\"\"\"\n86\t    measure_magnetometer(model, q_true, B_I) -> (b_meas, is_valid)\n87\t\n88\tB_I in inertial frame (nT). Returns normalized body-frame vector. ADS-SNS-003.\n89\t\"\"\"\n90\tfunction measure_magnetometer(model::MagnetometerModel,\n91\t                               q_true::AbstractVector,\n92\t                               B_I::AbstractVector)\n93\t    B_body = quat_rotate(q_true, B_I)\n94\t    B_noisy = B_body .+ model.noise_nT .* randn(3)\n95\t    n = norm(B_noisy)\n96\t    n < 1.0 && return (B_noisy, false)\n97\t    return (B_noisy ./ n, true)\n98\tend\n99\t\n100\t# ── Sun Sensor Model ──────────────────────────────────────────────────────────\n101\t\n102\tstruct SunSensorModel\n103\t    noise_sigma_rad::Float64\n104\t    fov_half_angle_rad::Float64\n105\tend\n106\tfunction SunSensorModel(; noise_deg::Float64 = 1.0, fov_deg::Float64 = 70.0)\n107\t    SunSensorModel(noise_deg * π / 180.0, fov_deg * π / 180.0)\n108\tend\n109\t\n110\t\"\"\"\n111\t    measure_sun_sensor(model, q_true, sun_I, eclipse_flag) -> (s_meas, is_valid)\n112\t\n113\tADS-SNS-004.\n114\t\"\"\"\n115\tfunction measure_sun_sensor(model::SunSensorModel,\n116\t                             q_true::AbstractVector,\n117\t                             sun_I::AbstractVector,\n118\t                             eclipse_flag::Bool)\n119\t    eclipse_flag && return ([0.0, 0.0, 1.0], false)\n120\t\n121\t    sun_body = quat_rotate(q_true, normalize(sun_I))\n122\t    # FOV check against boresight [0, 0, 1]\n123\t    cos_angle = clamp(sun_body[3], -1.0, 1.0)\n124\t    acos(cos_angle) > model.fov_half_angle_rad && return (sun_body, false)\n125\t\n126\t    noise = model.noise_sigma_rad .* randn(3)\n127\t    s_meas = normalize(sun_body .+ noise)\n128\t    return (s_meas, true)\n129\tend\n130\t\n131\t# ── Quaternion utilities ──────────────────────────────────────────────────────\n132\t\n133\t\"\"\"Hamilton product of two quaternions [w,x,y,z].\"\"\"\n134\tfunction quat_multiply(p::AbstractVector, q::AbstractVector)\n135\t    pw, px, py, pz = p[1], p[2], p[3], p[4]\n136\t    qw, qx, qy, qz = q[1], q[2], q[3], q[4]\n137\t    [pw*qw - px*qx - py*qy - pz*qz,\n138\t     pw*qx + px*qw + py*qz - pz*qy,\n139\t     pw*qy - px*qz + py*qw + pz*qx,\n140\t     pw*qz + px*qy - py*qx + pz*qw]\n141\tend\n142\t\n143\t\"\"\"Rotate vector v by quaternion q (active rotation).\"\"\"\n144\tfunction quat_rotate(q::AbstractVector, v::AbstractVector)\n145\t    qv = [0.0; v]\n146\t    qc = [q[1]; -q[2]; -q[3]; -q[4]]\n147\t    r = quat_multiply(quat_multiply(q, qv), qc)\n148\t    r[2:4]\n149\tend\n150\t\n151\t\"\"\"Angle in degrees between two quaternions.\"\"\"\n152\tfunction quat_angle_deg(q1::AbstractVector, q2::AbstractVector)\n153\t    q1c = [q1[1]; -q1[2]; -q1[3]; -q1[4]]\n154\t    dq = quat_multiply(q1c, q2)\n155\t    2.0 * acos(clamp(abs(dq[1]), 0.0, 1.0)) * 180.0 / π\n156\tend\n157\t\n158\t\"\"\"Quaternion from axis-angle.\"\"\"\n159\tfunction quat_from_axis_angle(axis::AbstractVector, angle::Float64)\n160\t    n = norm(axis)\n161\t    n < 1e-12 && return [1.0, 0.0, 0.0, 0.0]\n162\t    a = axis ./ n\n163\t    [cos(angle/2); a .* sin(angle/2)]\n164\tend\n165\t\n166\t"}]},"parent_tool_use_id":null,"session_id":"246a8ecb-0681-4d99-8a91-630970bd5e2f","uuid":"3ac4c469-83ba-42a8-bbbb-5737dbf653c7","timestamp":"2026-06-23T02:20:11.684Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Robbie/falcon/SpaceAGORA.jl/src/gnc/navigation/ads_sensor_models.jl","content":"# Attitude Determination Subsystem — Sensor Measurement Models\n# DRM 1 | Requirements: ADS-SNS-001 through ADS-SNS-004\n# Implements measurement models for: StarTracker, Gyroscope, Magnetometer, SunSensor\n\n# Quaternion convention: [w, x, y, z] (scalar first)\n\n# ── Star Tracker Model ────────────────────────────────────────────────────────\n\nstruct StarTrackerModel\n    noise_sigma_rad::Float64      # per-axis 1σ noise (rad)\n    fov_half_angle_rad::Float64   # field-of-view half-angle (rad)\n    sun_exclusion_rad::Float64    # minimum sun angle (rad)\nend\n\nfunction StarTrackerModel(;\n    noise_arcsec::Float64 = 5.0,\n    fov_deg::Float64 = 15.0,\n    sun_exclusion_deg::Float64 = 30.0)\n    StarTrackerModel(\n        noise_arcsec * π / (180.0 * 3600.0),\n        fov_deg * π / 180.0,\n        sun_exclusion_deg * π / 180.0)\nend\n\n\"\"\"\n    measure_star_tracker(model, q_true, sun_dir_body, eclipse_flag)\n\nReturn (q_meas, is_valid). ADS-SNS-001.\n\"\"\"\nfunction measure_star_tracker(model::StarTrackerModel,\n                               q_true::AbstractVector,\n                               sun_dir_body::AbstractVector,\n                               eclipse_flag::Bool)\n    eclipse_flag && return (copy(q_true), false)\n\n    # Sun exclusion check\n    s = normalize(sun_dir_body)\n    boresight = [0.0, 0.0, 1.0]\n    cos_angle = clamp(dot(s, boresight), -1.0, 1.0)\n    abs(acos(cos_angle)) < model.sun_exclusion_rad && return (copy(q_true), false)\n\n    # Add small rotation noise\n    noise_axis = normalize(randn(3))\n    noise_angle = model.noise_sigma_rad * randn()\n    half = noise_angle / 2\n    δq = [cos(half); noise_axis .* sin(half)]\n    q_meas = quat_multiply(q_true, δq)\n    return (normalize(q_meas), true)\nend\n\n# ── Gyroscope Model ───────────────────────────────────────────────────────────\n\nmutable struct GyroModel\n    arw_sigma::Float64        # angle random walk σ per root-Hz (rad/s/√Hz)\n    bias_sigma::Float64       # bias random walk σ per step (rad/s)\n    bias::Vector{Float64}     # current bias (truth, rad/s)\nend\n\nfunction GyroModel(;\n    arw_deg_sqrthr::Float64 = 0.1,\n    bias_deg_hr::Float64 = 1.0)\n    arw = arw_deg_sqrthr * π / 180.0 / sqrt(3600.0)\n    bias_rw = bias_deg_hr * π / 180.0 / 3600.0\n    GyroModel(arw, bias_rw, zeros(3))\nend\n\n\"\"\"\n    measure_gyro!(model, omega_true, dt) -> (omega_meas, is_valid)\n\nADS-SNS-002.\n\"\"\"\nfunction measure_gyro!(model::GyroModel, omega_true::AbstractVector, dt::Float64)\n    arw_noise = (model.arw_sigma / sqrt(dt)) .* randn(3)\n    model.bias .+= model.bias_sigma .* sqrt(dt) .* randn(3)\n    return (omega_true .+ model.bias .+ arw_noise, true)\nend\n\n# ── Magnetometer Model ────────────────────────────────────────────────────────\n\nstruct MagnetometerModel\n    noise_nT::Float64    # per-axis 1σ noise (nT)\nend\nMagnetometerModel(; noise_nT::Float64 = 50.0) = MagnetometerModel(noise_nT)\n\n\"\"\"\n    measure_magnetometer(model, q_true, B_I) -> (b_meas, is_valid)\n\nB_I in inertial frame (nT). Returns normalized body-frame vector. ADS-SNS-003.\n\"\"\"\nfunction measure_magnetometer(model::MagnetometerModel,\n                               q_true::AbstractVector,\n                               B_I::AbstractVector)\n    B_body = quat_rotate(q_true, B_I)\n    B_noisy = B_body .+ model.noise_nT .* randn(3)\n    n = norm(B_noisy)\n    n < 1.0 && return (B_noisy, false)\n    return (B_noisy ./ n, true)\nend\n\n# ── Sun Sensor Model ──────────────────────────────────────────────────────────\n\nstruct SunSensorModel\n    noise_sigma_rad::Float64\n    fov_half_angle_rad::Float64\nend\nfunction SunSensorModel(; noise_deg::Float64 = 1.0, fov_deg::Float64 = 70.0)\n    SunSensorModel(noise_deg * π / 180.0, fov_deg * π / 180.0)\nend\n\n\"\"\"\n    measure_sun_sensor(model, q_true, sun_I, eclipse_flag) -> (s_meas, is_valid)\n\nADS-SNS-004.\n\"\"\"\nfunction measure_sun_sensor(model::SunSensorModel,\n                             q_true::AbstractVector,\n                             sun_I::AbstractVector,\n                             eclipse_flag::Bool)\n    eclipse_flag && return ([0.0, 0.0, 1.0], false)\n\n    sun_body = quat_rotate(q_true, normalize(sun_I))\n    # FOV check against boresight [0, 0, 1]\n    cos_angle = clamp(sun_body[3], -1.0, 1.0)\n    acos(cos_angle) > model.fov_half_angle_rad && return (sun_body, false)\n\n    noise = model.noise_sigma_rad .* randn(3)\n    s_meas = normalize(sun_body .+ noise)\n    return (s_meas, true)\nend\n\n# ── Quaternion utilities ──────────────────────────────────────────────────────\n\n\"\"\"Hamilton product of two quaternions [w,x,y,z].\"\"\"\nfunction quat_multiply(p::AbstractVector, q::AbstractVector)\n    pw, px, py, pz = p[1], p[2], p[3], p[4]\n    qw, qx, qy, qz = q[1], q[2], q[3], q[4]\n    [pw*qw - px*qx - py*qy - pz*qz,\n     pw*qx + px*qw + py*qz - pz*qy,\n     pw*qy - px*qz + py*qw + pz*qx,\n     pw*qz + px*qy - py*qx + pz*qw]\nend\n\n\"\"\"Rotate vector v by quaternion q (active rotation).\"\"\"\nfunction quat_rotate(q::AbstractVector, v::AbstractVector)\n    qv = [0.0; v]\n    qc = [q[1]; -q[2]; -q[3]; -q[4]]\n    r = quat_multiply(quat_multiply(q, qv), qc)\n    r[2:4]\nend\n\n\"\"\"Angle in degrees between two quaternions.\"\"\"\nfunction quat_angle_deg(q1::AbstractVector, q2::AbstractVector)\n    q1c = [q1[1]; -q1[2]; -q1[3]; -q1[4]]\n    dq = quat_multiply(q1c, q2)\n    2.0 * acos(clamp(abs(dq[1]), 0.0, 1.0)) * 180.0 / π\nend\n\n\"\"\"Quaternion from axis-angle.\"\"\"\nfunction quat_from_axis_angle(axis::AbstractVector, angle::Float64)\n    n = norm(axis)\n    n < 1e-12 && return [1.0, 0.0, 0.0, 0.0]\n    a = axis ./ n\n    [cos(angle/2); a .* sin(angle/2)]\nend\n\n","numLines":166,"startLine":1,"totalLines":166}}}
