          "type": "string"
        },
        "density_model": {
          "default": "gram",
          "title": "Density Model",
          "type": "string"
        },
        "thermal_model": {
          "default": "maxwellian",
          "title": "Thermal Model",
          "type": "string"
        },
        "aerodynamic_model": {
          "default": "mach_dependent",
          "title": "Aerodynamic Model",
          "type": "string"
        },
        "wind": {
          "default": true,
          "title": "Wind",
          "type": "boolean"
        },
        "srp": {
          "default": false,
          "title": "Srp",
          "type": "boolean"
        },
        "n_bodies": {
          "items": {
            "type": "string"
          },
          "title": "N Bodies",
          "type": "array"
        }
      },
      "title": "SimulationModels",
      "type": "object"
    }
