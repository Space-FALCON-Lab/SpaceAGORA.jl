nSensorModel\\n  mekf::ADSMEKFState\\n  mode_mgr::ADSModeManager\\n  last_t::Float64\\n  initialized::Bool\\nend\\n\\nfunction ADSNavigationEffector(config::ADSConfig = ADSConfig())\\nfunction _Q(config::ADSConfig, dt::Float64)\\n_R_st(config::ADSConfig) =\\n_R_mag(config::ADSConfig) =\\n_R_sun(config::ADSConfig) =\\nfunction calcNavigationEffect!(effector::ADSNavigationEffector,\\n  model, u, p, t::Float64, sat_idx::Int)\\nfunction register_ads_navigation!(sim_config; config::ADSConfig = ADSConfig())\",\n    \"model:ports:node-mqpnhtg7-e7ht\": \"[{\\\"name\\\":\\\"in\\\",\\\"kind\\\":\\\"data\\\",\\\"direction\\\":\\\"in\\\",\\\"dataType\\\":\\\"Module\\\"},{\\\"name\\\":\\\"out\\\",\\\"kind\\\":\\\"data\\\",\\\"direction\\\":\\\"out\\\",\\\"dataType\\\":\\\"Module\\\"}]\",\n    \"model:exports:src-gnc\": \"[\\\"PropulsiveManeuverCommand\\\",\\\"PropulsiveBurnPlan\\\",\\\"AerobrakingControlCommand\\\",\\\"calcControlForceTorque\\\",\\\"calcControlEffect!\\\",\\\"calcControlMassFlowRate\\\",\\\"calcGuidanceEffect!\\\",\\\"AbstractAerobrakingStrategy\\\",\\\"EEdgStrategy\\\",\\\"TEdgStrategy\\\",\\\"AerobrakingGuidanceInput\\\",\\\"AerobrakingGuidanceOutput\\\",\\\"compute_aerobraking_guidance\\\",\\\"dispatch_aerobraking_guidance\\\",\\\"AerobrakingCampaignPropulsiveManeuverGuidanceModel\\\",\\\"calcNavigationEffect!\\\"]\",\n    \"model:exports:src-gnc-navigation\": \"[\\\"calcNavigationEffect!\\\"]\",\n    \"ownership:src/gnc/command_types.jl\": \"src-gnc\",\n    \"ownership:src/gnc/control/aerobraking/constraint_tracking.jl\": \"src-gnc\",\n    \"ownership:src/gnc/control/aerobraking/control_commands.jl\": \"src-gnc\",\n    \"ownership:src/gnc/control/aerobraking/tracking_executor.jl\": \"src-gnc\",\n    \"ownership:src/gnc/control/attitude_control_models.jl\": \"src-gnc\",\n    \"ownership:src/gnc/control/control_hooks.jl\": \"src-gnc\",\n    \"ownership:src/gnc/control/propulsive_maneuvers.jl\": \"src-gnc\",\n    \"ownership:src/gnc/guidance/aerobraking/common/