### Choose the Build Type (for speed use release)
BUILD = release
#BUILD = debug

### Select the compiler collection (auto-detected by host OS)
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
include ../makefile.defs.macos
else ifneq ($(filter Windows_NT,$(OS)),)
include ../makefile.defs.mingw
else ifneq ($(filter MINGW% MSYS% CYGWIN%,$(UNAME_S)),)
include ../makefile.defs.mingw
else
include ../makefile.defs.gcc
endif

### If no Fortran compiler is present, uncomment the line below.
undefine FC
