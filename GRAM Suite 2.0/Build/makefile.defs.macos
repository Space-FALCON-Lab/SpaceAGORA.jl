### Set the Build Environment (C++, C, and FORTRAN compilers)
CXX := clang++
CC := clang
FC := gfortran
# Linker
LNK := clang++
FLNK := gfortran

### Your preferred extension for executable (typically none on macOS/Linux, .exe on Windows)
BINARY_EXTENSION :=

### Shared library settings
SHARED_EXTENSION := dylib
SHARED_LNK_FLAGS := -dynamiclib

### Set the Compiler Optimization Level (debug and release)
ifeq ($(BUILD),debug)
  OPT_FLAGS := -g
else
  OPT_FLAGS := -O2
endif

### Set other Compiler Flags (C++, C, FORTRAN)
CXX_FLAGS := -std=c++11 -Wall -fPIC -stdlib=libc++
CC_FLAGS := -std=c99 -Wall -fPIC
FC_FLAGS := -std=f2003 -Wall -ffree-line-length-none
LNK_FLAGS := -lm -pthread -stdlib=libc++
FLNK_FLAGS := -lm -pthread -lgfortran

### Relative Directory Locations (relative to makefiles in Build subdirectories)
BASE_DIR = ../..
COMMON_DIR := $(BASE_DIR)/common
OBJECT_DIR = ./obj
TEST_OBJECT_DIR = ./tobj
LIBRARY_DIR = ../lib
BINARY_DIR = ../bin
MODULE_DIR = ../mod

### Set the location of the NAIF SPICE library (override with `SPICE_LIB=...` as needed)
UNAME_M := $(shell uname -m)
BREW_CSPICE_ARM64 := /opt/homebrew/opt/cspice/lib/cspice.a
BREW_CSPICE_X86_64 := /usr/local/opt/cspice/lib/cspice.a
ifeq ($(UNAME_M),arm64)
  ifneq ($(wildcard $(COMMON_DIR)/cspice/lib/cspice_macos_arm64.a),)
    SPICE_LIB ?= $(COMMON_DIR)/cspice/lib/cspice_macos_arm64.a
  else ifneq ($(wildcard $(BREW_CSPICE_ARM64)),)
    SPICE_LIB ?= $(BREW_CSPICE_ARM64)
  else
    SPICE_LIB ?= -lcspice
  endif
else ifeq ($(UNAME_M),x86_64)
  ifneq ($(wildcard $(COMMON_DIR)/cspice/lib/cspice_macos_x86_64.a),)
    SPICE_LIB ?= $(COMMON_DIR)/cspice/lib/cspice_macos_x86_64.a
  else ifneq ($(wildcard $(BREW_CSPICE_X86_64)),)
    SPICE_LIB ?= $(BREW_CSPICE_X86_64)
  else
    SPICE_LIB ?= -lcspice
  endif
else
  $(warning Unknown macOS architecture $(UNAME_M). Set SPICE_LIB manually.)
  SPICE_LIB ?= -lcspice
endif
